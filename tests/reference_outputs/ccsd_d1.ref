
#    D1(m,n):

# 	  1.000000000000 d(m,n)
# 	 ['+1.000', 'd(m,n)']
opdm[o, o] +=  1.000000000000 * einsum('mn->mn', kd[o, o])

# 	 -1.000000000000 t1(a,m)*l1(n,a)
# 	 ['-1.000', 't1(a,m)', 'l1(n,a)']
opdm[o, o] += -1.000000000000 * einsum('am,na->mn', t1, l1)

# 	 -0.500000000000 t2(a,b,i,m)*l2(i,n,a,b)
# 	 ['-0.500', 't2(a,b,i,m)', 'l2(i,n,a,b)']
opdm[o, o] += -0.500000000000 * einsum('abim,inab->mn', t2, l2)


#    D1(e,f):

#	  1.000000000000 t1(f,i)*l1(i,e)
#	 ['+1.000', 't1(f,i)', 'l1(i,e)']
opdm[v, v] +=  1.000000000000 * einsum('fi,ie->ef', t1, l1)

#	  0.500000000000 t2(f,a,j,i)*l2(j,i,e,a)
#	 ['+0.500', 't2(f,a,j,i)', 'l2(j,i,e,a)']
opdm[v, v] +=  0.500000000000 * einsum('faji,jiea->ef', t2, l2)


#    D1(e,m):

#	  1.000000000000 l1(m,e)
#	 ['+1.000', 'l1(m,e)']
opdm[v, o] +=  1.000000000000 * einsum('me->em', l1)


#    D1(m,e):

#	  1.000000000000 t1(e,m)
#	 ['+1.000', 't1(e,m)']
opdm[o, v] +=  1.000000000000 * einsum('em->me', t1)

#	 -1.000000000000 t2(e,a,i,m)*l1(i,a)
#	 ['-1.000', 't2(e,a,i,m)', 'l1(i,a)']
opdm[o, v] += -1.000000000000 * einsum('eaim,ia->me', t2, l1)

#	 -0.500000000000 t1(e,i)*t2(a,b,j,m)*l2(j,i,a,b)
#	 ['-0.500', 't1(e,i)', 't2(a,b,j,m)', 'l2(j,i,a,b)']
opdm[o, v] += -0.500000000000 * einsum('ei,abjm,jiab->me', t1, t2, l2, optimize=['einsum_path', (1, 2), (0, 1)])

#	 -0.500000000000 t1(a,m)*t2(e,b,j,i)*l2(j,i,a,b)
#	 ['-0.500', 't1(a,m)', 't2(e,b,j,i)', 'l2(j,i,a,b)']
opdm[o, v] += -0.500000000000 * einsum('am,ebji,jiab->me', t1, t2, l2, optimize=['einsum_path', (1, 2), (0, 1)])

#	 -1.000000000000 t1(a,m)*t1(e,i)*l1(i,a)
#	 ['-1.000', 't1(a,m)', 't1(e,i)', 'l1(i,a)']
opdm[o, v] += -1.000000000000 * einsum('am,ei,ia->me', t1, t1, l1, optimize=['einsum_path', (0, 2), (0, 1)])

