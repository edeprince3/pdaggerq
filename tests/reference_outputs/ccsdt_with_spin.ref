#	  1.000000000000 P(a,b)<m,l||e,d>_aaaa*t1_aa(a,l)*t1_aa(d,i)*t1_aa(e,j)*t2_abab(b,c,m,k)
contracted_intermediate =  1.000000000000 * einsum('mled,al,di,ej,bcmk->abcijk', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 <m,l||d,e>_aaaa*t1_aa(a,l)*t1_aa(b,m)*t1_aa(d,i)*t2_abab(e,c,j,k)
triples_res += -1.000000000000 * einsum('mlde,al,bm,di,ecjk->abcijk', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 3), (0, 2), (0, 1)])

#	  1.000000000000 <l,m||d,e>_abab*t1_aa(a,l)*t1_bb(c,m)*t1_aa(d,i)*t2_abab(b,e,j,k)
triples_res +=  1.000000000000 * einsum('lmde,al,cm,di,bejk->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <l,m||d,e>_abab*t1_aa(b,l)*t1_bb(c,m)*t1_aa(d,i)*t2_abab(a,e,j,k)
triples_res += -1.000000000000 * einsum('lmde,bl,cm,di,aejk->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

return triples_res

