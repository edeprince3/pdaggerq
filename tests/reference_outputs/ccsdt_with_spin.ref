triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacikj', contracted_intermediate) 

#	  1.000000000000 P(j,k)<m,l||e,d>_abab*t1_bb(c,l)*t1_bb(d,k)*t3_abbabb(e,a,b,m,j,i)
contracted_intermediate =  1.000000000000 * einsum('mled,cl,dk,eabmji->abcijk', g_abab[oa, ob, va, vb], t1_bb, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	  1.000000000000 P(j,k)<m,l||d,e>_bbbb*t1_bb(c,l)*t1_bb(d,k)*t3_bbbbbb(e,a,b,i,j,m)
contracted_intermediate =  1.000000000000 * einsum('mlde,cl,dk,eabijm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -0.500000000000 <l,m||e,d>_bbbb*t1_bb(d,i)*t1_bb(e,j)*t3_bbbbbb(a,b,c,k,l,m)
triples_res += -0.500000000000 * einsum('lmed,di,ej,abcklm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 P(a,b)<m,l||e,d>_abab*t1_bb(a,l)*t1_bb(d,i)*t3_abbabb(e,b,c,m,k,j)
contracted_intermediate =  1.000000000000 * einsum('mled,al,di,ebcmkj->abcijk', g_abab[oa, ob, va, vb], t1_bb, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 P(a,b)<m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(d,i)*t3_bbbbbb(e,b,c,j,k,m)
contracted_intermediate =  1.000000000000 * einsum('mlde,al,di,ebcjkm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 <m,l||e,d>_abab*t1_bb(c,l)*t1_bb(d,i)*t3_abbabb(e,a,b,m,k,j)
triples_res +=  1.000000000000 * einsum('mled,cl,di,eabmkj->abcijk', g_abab[oa, ob, va, vb], t1_bb, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])

#	  1.000000000000 <m,l||d,e>_bbbb*t1_bb(c,l)*t1_bb(d,i)*t3_bbbbbb(e,a,b,j,k,m)
triples_res +=  1.000000000000 * einsum('mlde,cl,di,eabjkm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])

#	 -0.500000000000 P(b,c)<m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(b,m)*t3_bbbbbb(d,e,c,i,j,k)
contracted_intermediate = -0.500000000000 * einsum('mlde,al,bm,decijk->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -0.500000000000 <m,l||d,e>_bbbb*t1_bb(b,l)*t1_bb(c,m)*t3_bbbbbb(d,e,a,i,j,k)
triples_res += -0.500000000000 * einsum('mlde,bl,cm,deaijk->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])

#	 -1.000000000000 P(i,j)*P(a,b)<m,l||e,d>_bbbb*t1_bb(a,l)*t1_bb(d,j)*t1_bb(e,k)*t2_bbbb(b,c,i,m)
contracted_intermediate = -1.000000000000 * einsum('mled,al,dj,ek,bcim->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<m,l||e,d>_bbbb*t1_bb(c,l)*t1_bb(d,j)*t1_bb(e,k)*t2_bbbb(a,b,i,m)
contracted_intermediate = -1.000000000000 * einsum('mled,cl,dj,ek,abim->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 P(j,k)*P(b,c)<m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(b,m)*t1_bb(d,k)*t2_bbbb(e,c,i,j)
contracted_intermediate = -1.000000000000 * einsum('mlde,al,bm,dk,ecij->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(j,k)<m,l||d,e>_bbbb*t1_bb(b,l)*t1_bb(c,m)*t1_bb(d,k)*t2_bbbb(e,a,i,j)
contracted_intermediate = -1.000000000000 * einsum('mlde,bl,cm,dk,eaij->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<m,l||e,d>_bbbb*t1_bb(a,l)*t1_bb(d,i)*t1_bb(e,j)*t2_bbbb(b,c,k,m)
contracted_intermediate = -1.000000000000 * einsum('mled,al,di,ej,bckm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 <m,l||e,d>_bbbb*t1_bb(c,l)*t1_bb(d,i)*t1_bb(e,j)*t2_bbbb(a,b,k,m)
triples_res += -1.000000000000 * einsum('mled,cl,di,ej,abkm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])

#	 -1.000000000000 P(b,c)<m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(b,m)*t1_bb(d,i)*t2_bbbb(e,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('mlde,al,bm,di,ecjk->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 <m,l||d,e>_bbbb*t1_bb(b,l)*t1_bb(c,m)*t1_bb(d,i)*t2_bbbb(e,a,j,k)
triples_res += -1.000000000000 * einsum('mlde,bl,cm,di,eajk->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])

