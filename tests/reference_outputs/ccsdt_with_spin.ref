triples_res +=  1.000000000000 * einsum('lmed,al,cm,dk,ebij->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])

#	  1.000000000000 <m,l||d,e>_bbbb*t1_bb(b,l)*t1_bb(c,m)*t1_bb(d,k)*t2_abab(a,e,i,j)
triples_res +=  1.000000000000 * einsum('mlde,bl,cm,dk,aeij->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <l,m||e,d>_abab*t1_aa(a,l)*t1_bb(b,m)*t1_bb(d,k)*t2_abab(e,c,i,j)
triples_res += -1.000000000000 * einsum('lmed,al,bm,dk,ecij->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])

#	  1.000000000000 P(b,c)<m,l||e,d>_bbbb*t1_bb(b,l)*t1_bb(d,j)*t1_bb(e,k)*t2_abab(a,c,i,m)
contracted_intermediate =  1.000000000000 * einsum('mled,bl,dj,ek,acim->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

return triples_res

