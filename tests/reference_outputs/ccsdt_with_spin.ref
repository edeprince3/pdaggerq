['+1.000', '<a,j||c,b>_abab', 't1_bb(b,j)', 't1_aa(c,i)']
['+1.000', '<k,j||b,c>_aaaa', 't1_aa(a,k)', 't1_aa(b,j)', 't1_aa(c,i)']
['-1.000', '<k,j||c,b>_abab', 't1_aa(a,k)', 't1_bb(b,j)', 't1_aa(c,i)']

def ccsdt_t1_aa_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* a e(-T) H e(T) | 0> :

#	  1.000000000000 f_aa(a,i)
singles_res +=  1.000000000000 * einsum('ai->ai', f_aa[va, oa])

#	 -1.000000000000 f_aa(j,i)*t1_aa(a,j)
singles_res += -1.000000000000 * einsum('ji,aj->ai', f_aa[oa, oa], t1_aa)

#	  1.000000000000 f_aa(a,b)*t1_aa(b,i)
singles_res +=  1.000000000000 * einsum('ab,bi->ai', f_aa[va, va], t1_aa)

#	 -1.000000000000 f_aa(j,b)*t2_aaaa(b,a,i,j)
singles_res += -1.000000000000 * einsum('jb,baij->ai', f_aa[oa, va], t2_aaaa)

#	  1.000000000000 f_bb(j,b)*t2_abab(a,b,i,j)
singles_res +=  1.000000000000 * einsum('jb,abij->ai', f_bb[ob, vb], t2_abab)

#	 -1.000000000000 f_aa(j,b)*t1_aa(a,j)*t1_aa(b,i)
singles_res += -1.000000000000 * einsum('jb,aj,bi->ai', f_aa[oa, va], t1_aa, t1_aa, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <a,j||i,b>_aaaa*t1_aa(b,j)
singles_res +=  1.000000000000 * einsum('ajib,bj->ai', g_aaaa[va, oa, oa, va], t1_aa)

#	  1.000000000000 <a,j||i,b>_abab*t1_bb(b,j)
singles_res +=  1.000000000000 * einsum('ajib,bj->ai', g_abab[va, ob, oa, vb], t1_bb)

#	  0.500000000000 <j,k||i,b>_aaaa*t2_aaaa(b,a,j,k)
singles_res +=  0.500000000000 * einsum('jkib,bajk->ai', g_aaaa[oa, oa, oa, va], t2_aaaa)

#	 -0.500000000000 <j,k||i,b>_abab*t2_abab(a,b,j,k)
singles_res += -0.500000000000 * einsum('jkib,abjk->ai', g_abab[oa, ob, oa, vb], t2_abab)

#	 -0.500000000000 <k,j||i,b>_abab*t2_abab(a,b,k,j)
singles_res += -0.500000000000 * einsum('kjib,abkj->ai', g_abab[oa, ob, oa, vb], t2_abab)

#	  0.500000000000 <a,j||c,b>_aaaa*t2_aaaa(c,b,i,j)
singles_res +=  0.500000000000 * einsum('ajcb,cbij->ai', g_aaaa[va, oa, va, va], t2_aaaa)

#	  0.500000000000 <a,j||c,b>_abab*t2_abab(c,b,i,j)
singles_res +=  0.500000000000 * einsum('ajcb,cbij->ai', g_abab[va, ob, va, vb], t2_abab)

#	  0.500000000000 <a,j||b,c>_abab*t2_abab(b,c,i,j)
singles_res +=  0.500000000000 * einsum('ajbc,bcij->ai', g_abab[va, ob, va, vb], t2_abab)

#	  0.250000000000 <j,k||c,b>_aaaa*t3_aaaaaa(c,b,a,i,j,k)
singles_res +=  0.250000000000 * einsum('jkcb,cbaijk->ai', g_aaaa[oa, oa, va, va], t3_aaaaaa)

#	 -0.250000000000 <j,k||c,b>_abab*t3_aabaab(c,a,b,i,j,k)
singles_res += -0.250000000000 * einsum('jkcb,cabijk->ai', g_abab[oa, ob, va, vb], t3_aabaab)

#	 -0.250000000000 <k,j||c,b>_abab*t3_aabaab(c,a,b,i,k,j)
singles_res += -0.250000000000 * einsum('kjcb,cabikj->ai', g_abab[oa, ob, va, vb], t3_aabaab)

#	  0.250000000000 <j,k||b,c>_abab*t3_aabaab(a,b,c,i,j,k)
singles_res +=  0.250000000000 * einsum('jkbc,abcijk->ai', g_abab[oa, ob, va, vb], t3_aabaab)

#	  0.250000000000 <k,j||b,c>_abab*t3_aabaab(a,b,c,i,k,j)
singles_res +=  0.250000000000 * einsum('kjbc,abcikj->ai', g_abab[oa, ob, va, vb], t3_aabaab)

#	 -0.250000000000 <j,k||c,b>_bbbb*t3_abbabb(a,b,c,i,j,k)
singles_res += -0.250000000000 * einsum('jkcb,abcijk->ai', g_bbbb[ob, ob, vb, vb], t3_abbabb)

#	  0.500000000000 <k,j||c,b>_aaaa*t1_aa(a,j)*t2_aaaa(c,b,i,k)
singles_res +=  0.500000000000 * einsum('kjcb,aj,cbik->ai', g_aaaa[oa, oa, va, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 <j,k||c,b>_abab*t1_aa(a,j)*t2_abab(c,b,i,k)
singles_res += -0.500000000000 * einsum('jkcb,aj,cbik->ai', g_abab[oa, ob, va, vb], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 <j,k||b,c>_abab*t1_aa(a,j)*t2_abab(b,c,i,k)
singles_res += -0.500000000000 * einsum('jkbc,aj,bcik->ai', g_abab[oa, ob, va, vb], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  0.500000000000 <j,k||b,c>_aaaa*t1_aa(b,i)*t2_aaaa(c,a,j,k)
singles_res +=  0.500000000000 * einsum('jkbc,bi,cajk->ai', g_aaaa[oa, oa, va, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -0.500000000000 <j,k||b,c>_abab*t1_aa(b,i)*t2_abab(a,c,j,k)
singles_res += -0.500000000000 * einsum('jkbc,bi,acjk->ai', g_abab[oa, ob, va, vb], t1_aa, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -0.500000000000 <k,j||b,c>_abab*t1_aa(b,i)*t2_abab(a,c,k,j)
singles_res += -0.500000000000 * einsum('kjbc,bi,ackj->ai', g_abab[oa, ob, va, vb], t1_aa, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 <k,j||b,c>_aaaa*t1_aa(b,j)*t2_aaaa(c,a,i,k)
singles_res +=  1.000000000000 * einsum('kjbc,bj,caik->ai', g_aaaa[oa, oa, va, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <j,k||b,c>_abab*t1_aa(b,j)*t2_abab(a,c,i,k)
singles_res +=  1.000000000000 * einsum('jkbc,bj,acik->ai', g_abab[oa, ob, va, vb], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <k,j||c,b>_abab*t1_bb(b,j)*t2_aaaa(c,a,i,k)
singles_res += -1.000000000000 * einsum('kjcb,bj,caik->ai', g_abab[oa, ob, va, vb], t1_bb, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <k,j||b,c>_bbbb*t1_bb(b,j)*t2_abab(a,c,i,k)
singles_res += -1.000000000000 * einsum('kjbc,bj,acik->ai', g_bbbb[ob, ob, vb, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <k,j||i,b>_aaaa*t1_aa(a,k)*t1_aa(b,j)
singles_res += -1.000000000000 * einsum('kjib,ak,bj->ai', g_aaaa[oa, oa, oa, va], t1_aa, t1_aa, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 <k,j||i,b>_abab*t1_aa(a,k)*t1_bb(b,j)
singles_res += -1.000000000000 * einsum('kjib,ak,bj->ai', g_abab[oa, ob, oa, vb], t1_aa, t1_bb, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 <a,j||b,c>_aaaa*t1_aa(b,j)*t1_aa(c,i)
singles_res += -1.000000000000 * einsum('ajbc,bj,ci->ai', g_aaaa[va, oa, va, va], t1_aa, t1_aa, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <a,j||c,b>_abab*t1_bb(b,j)*t1_aa(c,i)
singles_res +=  1.000000000000 * einsum('ajcb,bj,ci->ai', g_abab[va, ob, va, vb], t1_bb, t1_aa, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <k,j||b,c>_aaaa*t1_aa(a,k)*t1_aa(b,j)*t1_aa(c,i)
singles_res +=  1.000000000000 * einsum('kjbc,ak,bj,ci->ai', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t1_aa, optimize=['einsum_path', (0, 2), (0, 2), (0, 1)])

#	 -1.000000000000 <k,j||c,b>_abab*t1_aa(a,k)*t1_bb(b,j)*t1_aa(c,i)
singles_res += -1.000000000000 * einsum('kjcb,ak,bj,ci->ai', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, optimize=['einsum_path', (0, 2), (0, 2), (0, 1)])

return singles_res

