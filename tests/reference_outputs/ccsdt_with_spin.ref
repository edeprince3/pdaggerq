def ccsdt_t2_aaaa_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* b a e(-T) H e(T) | 0> :

#	  1.000000000000 P(i,j)f_aa(k,i)*t2_aaaa(a,b,j,k)
contracted_intermediate =  1.000000000000 * einsum('ki,abjk->abij', f_aa[oa, oa], t2_aaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(a,b)f_aa(a,c)*t2_aaaa(c,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('ac,cbij->abij', f_aa[va, va], t2_aaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 f_aa(k,c)*t3_aaaaaa(c,a,b,i,j,k)
doubles_res +=  1.000000000000 * einsum('kc,cabijk->abij', f_aa[oa, va], t3_aaaaaa)

#	 -1.000000000000 f_bb(k,c)*t3_aabaab(b,a,c,i,j,k)
doubles_res += -1.000000000000 * einsum('kc,bacijk->abij', f_bb[ob, vb], t3_aabaab)

#	 -1.000000000000 P(a,b)f_aa(k,c)*t1_aa(a,k)*t2_aaaa(c,b,i,j)
contracted_intermediate = -1.000000000000 * einsum('kc,ak,cbij->abij', f_aa[oa, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(i,j)f_aa(k,c)*t1_aa(c,i)*t2_aaaa(a,b,j,k)
contracted_intermediate =  1.000000000000 * einsum('kc,ci,abjk->abij', f_aa[oa, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 <a,b||i,j>_aaaa
doubles_res +=  1.000000000000 * einsum('abij->abij', g_aaaa[va, va, oa, oa])

#	 -1.000000000000 P(a,b)<a,k||i,j>_aaaa*t1_aa(b,k)
contracted_intermediate = -1.000000000000 * einsum('akij,bk->abij', g_aaaa[va, oa, oa, oa], t1_aa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(i,j)<a,b||i,c>_aaaa*t1_aa(c,j)
contracted_intermediate =  1.000000000000 * einsum('abic,cj->abij', g_aaaa[va, va, oa, va], t1_aa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 <k,l||i,j>_aaaa*t2_aaaa(a,b,k,l)
doubles_res +=  0.500000000000 * einsum('klij,abkl->abij', g_aaaa[oa, oa, oa, oa], t2_aaaa)

#	 -1.000000000000 P(i,j)*P(a,b)<a,k||i,c>_aaaa*t2_aaaa(c,b,j,k)
contracted_intermediate = -1.000000000000 * einsum('akic,cbjk->abij', g_aaaa[va, oa, oa, va], t2_aaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  1.000000000000 P(i,j)*P(a,b)<a,k||i,c>_abab*t2_abab(b,c,j,k)
contracted_intermediate =  1.000000000000 * einsum('akic,bcjk->abij', g_abab[va, ob, oa, vb], t2_abab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  0.500000000000 <a,b||d,c>_aaaa*t2_aaaa(d,c,i,j)
doubles_res +=  0.500000000000 * einsum('abdc,dcij->abij', g_aaaa[va, va, va, va], t2_aaaa)

#	  0.500000000000 P(i,j)<k,l||i,c>_aaaa*t3_aaaaaa(c,a,b,j,k,l)
contracted_intermediate =  0.500000000000 * einsum('klic,cabjkl->abij', g_aaaa[oa, oa, oa, va], t3_aaaaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -0.500000000000 P(i,j)<k,l||i,c>_abab*t3_aabaab(b,a,c,j,k,l)
contracted_intermediate = -0.500000000000 * einsum('klic,bacjkl->abij', g_abab[oa, ob, oa, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -0.500000000000 P(i,j)<l,k||i,c>_abab*t3_aabaab(b,a,c,j,l,k)
contracted_intermediate = -0.500000000000 * einsum('lkic,bacjlk->abij', g_abab[oa, ob, oa, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<a,k||d,c>_aaaa*t3_aaaaaa(d,c,b,i,j,k)
contracted_intermediate = -0.500000000000 * einsum('akdc,dcbijk->abij', g_aaaa[va, oa, va, va], t3_aaaaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  0.500000000000 P(a,b)<a,k||d,c>_abab*t3_aabaab(d,b,c,i,j,k)
contracted_intermediate =  0.500000000000 * einsum('akdc,dbcijk->abij', g_abab[va, ob, va, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<a,k||c,d>_abab*t3_aabaab(b,c,d,i,j,k)
contracted_intermediate = -0.500000000000 * einsum('akcd,bcdijk->abij', g_abab[va, ob, va, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -1.000000000000 P(i,j)*P(a,b)<l,k||i,c>_aaaa*t1_aa(a,k)*t2_aaaa(c,b,j,l)
contracted_intermediate = -1.000000000000 * einsum('lkic,ak,cbjl->abij', g_aaaa[oa, oa, oa, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	 -1.000000000000 P(i,j)*P(a,b)<k,l||i,c>_abab*t1_aa(a,k)*t2_abab(b,c,j,l)
