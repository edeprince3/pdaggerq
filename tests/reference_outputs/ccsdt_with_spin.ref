doubles_res += -1.000000000000 * einsum('lkdc,al,ck,dbij->abij', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 2), (0, 1)])

#	 -1.000000000000 <k,l||c,d>_abab*t1_bb(b,l)*t1_aa(c,k)*t2_abab(a,d,i,j)
doubles_res += -1.000000000000 * einsum('klcd,bl,ck,adij->abij', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t2_abab, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])

#	  1.000000000000 <l,k||c,d>_bbbb*t1_bb(b,l)*t1_bb(c,k)*t2_abab(a,d,i,j)
doubles_res +=  1.000000000000 * einsum('lkcd,bl,ck,adij->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])

#	  1.000000000000 <l,k||c,d>_aaaa*t1_aa(c,k)*t1_aa(d,i)*t2_abab(a,b,l,j)
doubles_res +=  1.000000000000 * einsum('lkcd,ck,di,ablj->abij', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	 -1.000000000000 <l,k||d,c>_abab*t1_bb(c,k)*t1_aa(d,i)*t2_abab(a,b,l,j)
doubles_res += -1.000000000000 * einsum('lkdc,ck,di,ablj->abij', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	 -1.000000000000 <k,l||c,d>_abab*t1_aa(c,k)*t1_bb(d,j)*t2_abab(a,b,i,l)
doubles_res += -1.000000000000 * einsum('klcd,ck,dj,abil->abij', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 <l,k||c,d>_bbbb*t1_bb(c,k)*t1_bb(d,j)*t2_abab(a,b,i,l)
doubles_res +=  1.000000000000 * einsum('lkcd,ck,dj,abil->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 <k,l||i,c>_abab*t1_aa(a,k)*t1_bb(b,l)*t1_bb(c,j)
doubles_res +=  1.000000000000 * einsum('klic,ak,bl,cj->abij', g_abab[oa, ob, oa, vb], t1_aa, t1_bb, t1_bb, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <k,l||c,j>_abab*t1_aa(a,k)*t1_bb(b,l)*t1_aa(c,i)
doubles_res +=  1.000000000000 * einsum('klcj,ak,bl,ci->abij', g_abab[oa, ob, va, ob], t1_aa, t1_bb, t1_aa, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	 -1.000000000000 <a,k||c,d>_abab*t1_bb(b,k)*t1_aa(c,i)*t1_bb(d,j)
doubles_res += -1.000000000000 * einsum('akcd,bk,ci,dj->abij', g_abab[va, ob, va, vb], t1_bb, t1_aa, t1_bb, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <k,b||c,d>_abab*t1_aa(a,k)*t1_aa(c,i)*t1_bb(d,j)
doubles_res += -1.000000000000 * einsum('kbcd,ak,ci,dj->abij', g_abab[oa, vb, va, vb], t1_aa, t1_aa, t1_bb, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <k,l||c,d>_abab*t1_aa(a,k)*t1_bb(b,l)*t1_aa(c,i)*t1_bb(d,j)
doubles_res +=  1.000000000000 * einsum('klcd,ak,bl,ci,dj->abij', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, t1_bb, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

return doubles_res


