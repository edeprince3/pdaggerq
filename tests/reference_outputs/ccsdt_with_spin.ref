['-1.000', '<l,m||d,e>_abab', 't1_aa(b,l)', 't1_bb(c,m)', 't1_aa(d,i)', 't2_abab(a,e,j,k)']

def ccsdt_t3_aabaab_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* k* c b a e(-T) H e(T) | 0> :

#	 -1.000000000000 f_bb(l,k)*t3_aabaab(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('lk,abcijl->abcijk', f_bb[ob, ob], t3_aabaab)

#	 -1.000000000000 f_aa(l,j)*t3_aabaab(a,b,c,i,l,k)
triples_res += -1.000000000000 * einsum('lj,abcilk->abcijk', f_aa[oa, oa], t3_aabaab)

#	  1.000000000000 f_aa(l,i)*t3_aabaab(a,b,c,j,l,k)
triples_res +=  1.000000000000 * einsum('li,abcjlk->abcijk', f_aa[oa, oa], t3_aabaab)

#	  1.000000000000 P(a,b)f_aa(a,d)*t3_aabaab(d,b,c,i,j,k)
contracted_intermediate =  1.000000000000 * einsum('ad,dbcijk->abcijk', f_aa[va, va], t3_aabaab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 f_bb(c,d)*t3_aabaab(b,a,d,i,j,k)
triples_res += -1.000000000000 * einsum('cd,badijk->abcijk', f_bb[vb, vb], t3_aabaab)

#	 -1.000000000000 f_bb(l,d)*t1_bb(d,k)*t3_aabaab(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('ld,dk,abcijl->abcijk', f_bb[ob, vb], t1_bb, t3_aabaab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 f_aa(l,d)*t1_aa(d,j)*t3_aabaab(a,b,c,i,l,k)
triples_res += -1.000000000000 * einsum('ld,dj,abcilk->abcijk', f_aa[oa, va], t1_aa, t3_aabaab, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 f_aa(l,d)*t1_aa(d,i)*t3_aabaab(a,b,c,j,l,k)
triples_res +=  1.000000000000 * einsum('ld,di,abcjlk->abcijk', f_aa[oa, va], t1_aa, t3_aabaab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 P(a,b)f_aa(l,d)*t1_aa(a,l)*t3_aabaab(d,b,c,i,j,k)
contracted_intermediate = -1.000000000000 * einsum('ld,al,dbcijk->abcijk', f_aa[oa, va], t1_aa, t3_aabaab, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 f_bb(l,d)*t1_bb(c,l)*t3_aabaab(b,a,d,i,j,k)
triples_res +=  1.000000000000 * einsum('ld,cl,badijk->abcijk', f_bb[ob, vb], t1_bb, t3_aabaab, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 P(i,j)*P(a,b)f_bb(l,d)*t2_abab(a,d,j,k)*t2_abab(b,c,i,l)
contracted_intermediate =  1.000000000000 * einsum('ld,adjk,bcil->abcijk', f_bb[ob, vb], t2_abab, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	  1.000000000000 P(a,b)f_aa(l,d)*t2_aaaa(d,a,i,j)*t2_abab(b,c,l,k)
contracted_intermediate =  1.000000000000 * einsum('ld,daij,bclk->abcijk', f_aa[oa, va], t2_aaaa, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 P(i,j)f_aa(l,d)*t2_aaaa(a,b,i,l)*t2_abab(d,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('ld,abil,dcjk->abcijk', f_aa[oa, va], t2_aaaa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  1.000000000000 P(i,j)*P(a,b)<a,l||j,k>_abab*t2_abab(b,c,i,l)
contracted_intermediate =  1.000000000000 * einsum('aljk,bcil->abcijk', g_abab[va, ob, oa, ob], t2_abab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	  1.000000000000 P(a,b)<l,a||i,j>_aaaa*t2_abab(b,c,l,k)
contracted_intermediate =  1.000000000000 * einsum('laij,bclk->abcijk', g_aaaa[oa, va, oa, oa], t2_abab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<l,c||j,k>_abab*t2_aaaa(a,b,i,l)
contracted_intermediate = -1.000000000000 * einsum('lcjk,abil->abcijk', g_abab[oa, vb, oa, ob], t2_aaaa)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  1.000000000000 <a,c||d,k>_abab*t2_aaaa(d,b,i,j)
triples_res +=  1.000000000000 * einsum('acdk,dbij->abcijk', g_abab[va, vb, va, ob], t2_aaaa)

#	  1.000000000000 <a,b||d,j>_aaaa*t2_abab(d,c,i,k)
triples_res +=  1.000000000000 * einsum('abdj,dcik->abcijk', g_aaaa[va, va, va, oa], t2_abab)

#	 -1.000000000000 <a,c||j,d>_abab*t2_abab(b,d,i,k)
triples_res += -1.000000000000 * einsum('acjd,bdik->abcijk', g_abab[va, vb, oa, vb], t2_abab)

#	 -1.000000000000 <a,b||d,i>_aaaa*t2_abab(d,c,j,k)
triples_res += -1.000000000000 * einsum('abdi,dcjk->abcijk', g_aaaa[va, va, va, oa], t2_abab)

#	  1.000000000000 <a,c||i,d>_abab*t2_abab(b,d,j,k)
triples_res +=  1.000000000000 * einsum('acid,bdjk->abcijk', g_abab[va, vb, oa, vb], t2_abab)

#	 -1.000000000000 <b,c||d,k>_abab*t2_aaaa(d,a,i,j)
triples_res += -1.000000000000 * einsum('bcdk,daij->abcijk', g_abab[va, vb, va, ob], t2_aaaa)

#	  1.000000000000 <b,c||j,d>_abab*t2_abab(a,d,i,k)
triples_res +=  1.000000000000 * einsum('bcjd,adik->abcijk', g_abab[va, vb, oa, vb], t2_abab)

#	 -1.000000000000 <b,c||i,d>_abab*t2_abab(a,d,j,k)
triples_res += -1.000000000000 * einsum('bcid,adjk->abcijk', g_abab[va, vb, oa, vb], t2_abab)

#	  0.500000000000 P(i,j)<l,m||j,k>_abab*t3_aabaab(a,b,c,i,l,m)
contracted_intermediate =  0.500000000000 * einsum('lmjk,abcilm->abcijk', g_abab[oa, ob, oa, ob], t3_aabaab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  0.500000000000 P(i,j)<m,l||j,k>_abab*t3_aabaab(a,b,c,i,m,l)
contracted_intermediate =  0.500000000000 * einsum('mljk,abciml->abcijk', g_abab[oa, ob, oa, ob], t3_aabaab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -0.500000000000 <l,m||i,j>_aaaa*t3_aabaab(a,b,c,m,l,k)
triples_res += -0.500000000000 * einsum('lmij,abcmlk->abcijk', g_aaaa[oa, oa, oa, oa], t3_aabaab)

#	 -1.000000000000 P(a,b)<a,l||d,k>_abab*t3_aabaab(d,b,c,i,j,l)
contracted_intermediate = -1.000000000000 * einsum('aldk,dbcijl->abcijk', g_abab[va, ob, va, ob], t3_aabaab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 P(a,b)<l,a||d,j>_aaaa*t3_aabaab(d,b,c,i,l,k)
contracted_intermediate =  1.000000000000 * einsum('ladj,dbcilk->abcijk', g_aaaa[oa, va, va, oa], t3_aabaab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 P(a,b)<a,l||j,d>_abab*t3_abbabb(b,d,c,i,k,l)
contracted_intermediate =  1.000000000000 * einsum('aljd,bdcikl->abcijk', g_abab[va, ob, oa, vb], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<l,a||d,i>_aaaa*t3_aabaab(d,b,c,j,l,k)
contracted_intermediate = -1.000000000000 * einsum('ladi,dbcjlk->abcijk', g_aaaa[oa, va, va, oa], t3_aabaab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<a,l||i,d>_abab*t3_abbabb(b,d,c,j,k,l)
contracted_intermediate = -1.000000000000 * einsum('alid,bdcjkl->abcijk', g_abab[va, ob, oa, vb], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 <l,c||d,k>_abab*t3_aaaaaa(d,a,b,i,j,l)
triples_res +=  1.000000000000 * einsum('lcdk,dabijl->abcijk', g_abab[oa, vb, va, ob], t3_aaaaaa)

#	 -1.000000000000 <l,c||d,k>_bbbb*t3_aabaab(b,a,d,i,j,l)
triples_res += -1.000000000000 * einsum('lcdk,badijl->abcijk', g_bbbb[ob, vb, vb, ob], t3_aabaab)

#	  1.000000000000 <l,c||j,d>_abab*t3_aabaab(b,a,d,i,l,k)
triples_res +=  1.000000000000 * einsum('lcjd,badilk->abcijk', g_abab[oa, vb, oa, vb], t3_aabaab)

#	 -1.000000000000 <l,c||i,d>_abab*t3_aabaab(b,a,d,j,l,k)
triples_res += -1.000000000000 * einsum('lcid,badjlk->abcijk', g_abab[oa, vb, oa, vb], t3_aabaab)

#	  0.500000000000 <a,b||e,d>_aaaa*t3_aabaab(e,d,c,i,j,k)
triples_res +=  0.500000000000 * einsum('abed,edcijk->abcijk', g_aaaa[va, va, va, va], t3_aabaab)

#	  0.500000000000 <a,c||e,d>_abab*t3_aabaab(e,b,d,i,j,k)
triples_res +=  0.500000000000 * einsum('aced,ebdijk->abcijk', g_abab[va, vb, va, vb], t3_aabaab)

#	 -0.500000000000 <a,c||d,e>_abab*t3_aabaab(b,d,e,i,j,k)
triples_res += -0.500000000000 * einsum('acde,bdeijk->abcijk', g_abab[va, vb, va, vb], t3_aabaab)

#	 -0.500000000000 <b,c||e,d>_abab*t3_aabaab(e,a,d,i,j,k)
triples_res += -0.500000000000 * einsum('bced,eadijk->abcijk', g_abab[va, vb, va, vb], t3_aabaab)

#	  0.500000000000 <b,c||d,e>_abab*t3_aabaab(a,d,e,i,j,k)
