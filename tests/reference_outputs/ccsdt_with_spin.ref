def ccsdt_t3_bbbbbb_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* k* c b a e(-T) H e(T) | 0> :

#	 -1.000000000000 P(j,k)f_bb(l,k)*t3_bbbbbb(a,b,c,i,j,l)
contracted_intermediate = -1.000000000000 * einsum('lk,abcijl->abcijk', f_bb[ob, ob], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,i)*t3_bbbbbb(a,b,c,j,k,l)
triples_res += -1.000000000000 * einsum('li,abcjkl->abcijk', f_bb[ob, ob], t3_bbbbbb)

#	  1.000000000000 P(a,b)f_bb(a,d)*t3_bbbbbb(d,b,c,i,j,k)
contracted_intermediate =  1.000000000000 * einsum('ad,dbcijk->abcijk', f_bb[vb, vb], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 f_bb(c,d)*t3_bbbbbb(d,a,b,i,j,k)
triples_res +=  1.000000000000 * einsum('cd,dabijk->abcijk', f_bb[vb, vb], t3_bbbbbb)

#	 -1.000000000000 P(j,k)f_bb(l,d)*t1_bb(d,k)*t3_bbbbbb(a,b,c,i,j,l)
contracted_intermediate = -1.000000000000 * einsum('ld,dk,abcijl->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,d)*t1_bb(d,i)*t3_bbbbbb(a,b,c,j,k,l)
triples_res += -1.000000000000 * einsum('ld,di,abcjkl->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 P(a,b)f_bb(l,d)*t1_bb(a,l)*t3_bbbbbb(d,b,c,i,j,k)
contracted_intermediate = -1.000000000000 * einsum('ld,al,dbcijk->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,d)*t1_bb(c,l)*t3_bbbbbb(d,a,b,i,j,k)
triples_res += -1.000000000000 * einsum('ld,cl,dabijk->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 P(i,j)*P(a,b)f_bb(l,d)*t2_bbbb(d,a,j,k)*t2_bbbb(b,c,i,l)
contracted_intermediate = -1.000000000000 * einsum('ld,dajk,bcil->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(a,b)f_bb(l,d)*t2_bbbb(d,a,i,j)*t2_bbbb(b,c,k,l)
contracted_intermediate = -1.000000000000 * einsum('ld,daij,bckl->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 P(i,j)f_bb(l,d)*t2_bbbb(a,b,i,l)*t2_bbbb(d,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('ld,abil,dcjk->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,d)*t2_bbbb(a,b,k,l)*t2_bbbb(d,c,i,j)
triples_res += -1.000000000000 * einsum('ld,abkl,dcij->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 P(i,j)*P(a,b)<l,a||j,k>_bbbb*t2_bbbb(b,c,i,l)
contracted_intermediate = -1.000000000000 * einsum('lajk,bcil->abcijk', g_bbbb[ob, vb, ob, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<l,a||i,j>_bbbb*t2_bbbb(b,c,k,l)
contracted_intermediate = -1.000000000000 * einsum('laij,bckl->abcijk', g_bbbb[ob, vb, ob, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<l,c||j,k>_bbbb*t2_bbbb(a,b,i,l)
contracted_intermediate = -1.000000000000 * einsum('lcjk,abil->abcijk', g_bbbb[ob, vb, ob, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 <l,c||i,j>_bbbb*t2_bbbb(a,b,k,l)
triples_res += -1.000000000000 * einsum('lcij,abkl->abcijk', g_bbbb[ob, vb, ob, ob], t2_bbbb)

#	 -1.000000000000 P(j,k)*P(b,c)<a,b||d,k>_bbbb*t2_bbbb(d,c,i,j)
contracted_intermediate = -1.000000000000 * einsum('abdk,dcij->abcijk', g_bbbb[vb, vb, vb, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(b,c)<a,b||d,i>_bbbb*t2_bbbb(d,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('abdi,dcjk->abcijk', g_bbbb[vb, vb, vb, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 P(j,k)<b,c||d,k>_bbbb*t2_bbbb(d,a,i,j)
contracted_intermediate = -1.000000000000 * einsum('bcdk,daij->abcijk', g_bbbb[vb, vb, vb, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -1.000000000000 <b,c||d,i>_bbbb*t2_bbbb(d,a,j,k)
triples_res += -1.000000000000 * einsum('bcdi,dajk->abcijk', g_bbbb[vb, vb, vb, ob], t2_bbbb)

#	  0.500000000000 P(i,j)<l,m||j,k>_bbbb*t3_bbbbbb(a,b,c,i,l,m)
contracted_intermediate =  0.500000000000 * einsum('lmjk,abcilm->abcijk', g_bbbb[ob, ob, ob, ob], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  0.500000000000 <l,m||i,j>_bbbb*t3_bbbbbb(a,b,c,k,l,m)
triples_res +=  0.500000000000 * einsum('lmij,abcklm->abcijk', g_bbbb[ob, ob, ob, ob], t3_bbbbbb)

#	 -1.000000000000 P(j,k)*P(a,b)<l,a||d,k>_abab*t3_abbabb(d,b,c,l,j,i)
contracted_intermediate = -1.000000000000 * einsum('ladk,dbclji->abcijk', g_abab[oa, vb, va, ob], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacikj', contracted_intermediate) 

#	  1.000000000000 P(j,k)*P(a,b)<l,a||d,k>_bbbb*t3_bbbbbb(d,b,c,i,j,l)
contracted_intermediate =  1.000000000000 * einsum('ladk,dbcijl->abcijk', g_bbbb[ob, vb, vb, ob], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacikj', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<l,a||d,i>_abab*t3_abbabb(d,b,c,l,k,j)
contracted_intermediate = -1.000000000000 * einsum('ladi,dbclkj->abcijk', g_abab[oa, vb, va, ob], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 P(a,b)<l,a||d,i>_bbbb*t3_bbbbbb(d,b,c,j,k,l)
