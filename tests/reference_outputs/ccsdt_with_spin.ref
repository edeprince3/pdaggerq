def ccsdt_t2_bbbb_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* b a e(-T) H e(T) | 0> :

#	 -1.000000000000 P(i,j)f_bb(k,j)*t2_bbbb(a,b,i,k)
contracted_intermediate = -1.000000000000 * einsum('kj,abik->abij', f_bb[ob, ob], t2_bbbb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(a,b)f_bb(a,c)*t2_bbbb(c,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('ac,cbij->abij', f_bb[vb, vb], t2_bbbb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -1.000000000000 f_aa(k,c)*t3_abbabb(c,a,b,k,j,i)
doubles_res += -1.000000000000 * einsum('kc,cabkji->abij', f_aa[oa, va], t3_abbabb)

#	  1.000000000000 f_bb(k,c)*t3_bbbbbb(c,a,b,i,j,k)
doubles_res +=  1.000000000000 * einsum('kc,cabijk->abij', f_bb[ob, vb], t3_bbbbbb)

#	 -1.000000000000 P(i,j)f_bb(k,c)*t1_bb(c,j)*t2_bbbb(a,b,i,k)
contracted_intermediate = -1.000000000000 * einsum('kc,cj,abik->abij', f_bb[ob, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -1.000000000000 P(a,b)f_bb(k,c)*t1_bb(a,k)*t2_bbbb(c,b,i,j)
contracted_intermediate = -1.000000000000 * einsum('kc,ak,cbij->abij', f_bb[ob, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 <a,b||i,j>_bbbb
doubles_res +=  1.000000000000 * einsum('abij->abij', g_bbbb[vb, vb, ob, ob])

#	  1.000000000000 P(a,b)<k,a||i,j>_bbbb*t1_bb(b,k)
contracted_intermediate =  1.000000000000 * einsum('kaij,bk->abij', g_bbbb[ob, vb, ob, ob], t1_bb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(i,j)<a,b||c,j>_bbbb*t1_bb(c,i)
contracted_intermediate =  1.000000000000 * einsum('abcj,ci->abij', g_bbbb[vb, vb, vb, ob], t1_bb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 <k,l||i,j>_bbbb*t2_bbbb(a,b,k,l)
doubles_res +=  0.500000000000 * einsum('klij,abkl->abij', g_bbbb[ob, ob, ob, ob], t2_bbbb)

#	 -1.000000000000 P(i,j)*P(a,b)<k,a||c,j>_abab*t2_abab(c,b,k,i)
contracted_intermediate = -1.000000000000 * einsum('kacj,cbki->abij', g_abab[oa, vb, va, ob], t2_abab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  1.000000000000 P(i,j)*P(a,b)<k,a||c,j>_bbbb*t2_bbbb(c,b,i,k)
contracted_intermediate =  1.000000000000 * einsum('kacj,cbik->abij', g_bbbb[ob, vb, vb, ob], t2_bbbb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  0.500000000000 <a,b||d,c>_bbbb*t2_bbbb(d,c,i,j)
doubles_res +=  0.500000000000 * einsum('abdc,dcij->abij', g_bbbb[vb, vb, vb, vb], t2_bbbb)

#	 -0.500000000000 P(i,j)<k,l||c,j>_abab*t3_abbabb(c,a,b,k,i,l)
contracted_intermediate = -0.500000000000 * einsum('klcj,cabkil->abij', g_abab[oa, ob, va, ob], t3_abbabb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(i,j)<l,k||c,j>_abab*t3_abbabb(c,a,b,l,k,i)
contracted_intermediate =  0.500000000000 * einsum('lkcj,cablki->abij', g_abab[oa, ob, va, ob], t3_abbabb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(i,j)<k,l||c,j>_bbbb*t3_bbbbbb(c,a,b,i,k,l)
contracted_intermediate =  0.500000000000 * einsum('klcj,cabikl->abij', g_bbbb[ob, ob, vb, ob], t3_bbbbbb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<k,a||d,c>_abab*t3_abbabb(d,c,b,k,j,i)
contracted_intermediate = -0.500000000000 * einsum('kadc,dcbkji->abij', g_abab[oa, vb, va, vb], t3_abbabb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<k,a||c,d>_abab*t3_abbabb(c,d,b,k,j,i)
contracted_intermediate = -0.500000000000 * einsum('kacd,cdbkji->abij', g_abab[oa, vb, va, vb], t3_abbabb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  0.500000000000 P(a,b)<k,a||d,c>_bbbb*t3_bbbbbb(d,c,b,i,j,k)
contracted_intermediate =  0.500000000000 * einsum('kadc,dcbijk->abij', g_bbbb[ob, vb, vb, vb], t3_bbbbbb)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<k,l||c,j>_abab*t1_aa(c,k)*t2_bbbb(a,b,i,l)
contracted_intermediate = -1.000000000000 * einsum('klcj,ck,abil->abij', g_abab[oa, ob, va, ob], t1_aa, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(i,j)<l,k||c,j>_bbbb*t1_bb(c,k)*t2_bbbb(a,b,i,l)
contracted_intermediate =  1.000000000000 * einsum('lkcj,ck,abil->abij', g_bbbb[ob, ob, vb, ob], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(i,j)<k,l||c,j>_bbbb*t1_bb(c,i)*t2_bbbb(a,b,k,l)
contracted_intermediate =  0.500000000000 * einsum('klcj,ci,abkl->abij', g_bbbb[ob, ob, vb, ob], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(i,j)*P(a,b)<l,k||c,j>_abab*t1_bb(a,k)*t2_abab(c,b,l,i)
contracted_intermediate =  1.000000000000 * einsum('lkcj,ak,cbli->abij', g_abab[oa, ob, va, ob], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	 -1.000000000000 P(i,j)*P(a,b)<l,k||c,j>_bbbb*t1_bb(a,k)*t2_bbbb(c,b,i,l)
contracted_intermediate = -1.000000000000 * einsum('lkcj,ak,cbil->abij', g_bbbb[ob, ob, vb, ob], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  1.000000000000 P(a,b)<k,a||c,d>_abab*t1_aa(c,k)*t2_bbbb(d,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('kacd,ck,dbij->abij', g_abab[oa, vb, va, vb], t1_aa, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(a,b)<k,a||c,d>_bbbb*t1_bb(c,k)*t2_bbbb(d,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('kacd,ck,dbij->abij', g_bbbb[ob, vb, vb, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -1.000000000000 P(i,j)*P(a,b)<k,a||d,c>_abab*t1_bb(c,j)*t2_abab(d,b,k,i)
contracted_intermediate = -1.000000000000 * einsum('kadc,cj,dbki->abij', g_abab[oa, vb, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	 -1.000000000000 P(i,j)*P(a,b)<k,a||c,d>_bbbb*t1_bb(c,j)*t2_bbbb(d,b,i,k)
contracted_intermediate = -1.000000000000 * einsum('kacd,cj,dbik->abij', g_bbbb[ob, vb, vb, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  0.500000000000 P(a,b)<k,a||d,c>_bbbb*t1_bb(b,k)*t2_bbbb(d,c,i,j)
contracted_intermediate =  0.500000000000 * einsum('kadc,bk,dcij->abij', g_bbbb[ob, vb, vb, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 <l,k||c,d>_aaaa*t1_aa(c,k)*t3_abbabb(d,a,b,l,j,i)
doubles_res +=  1.000000000000 * einsum('lkcd,ck,dablji->abij', g_aaaa[oa, oa, va, va], t1_aa, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <k,l||c,d>_abab*t1_aa(c,k)*t3_bbbbbb(d,a,b,i,j,l)
doubles_res +=  1.000000000000 * einsum('klcd,ck,dabijl->abij', g_abab[oa, ob, va, vb], t1_aa, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <l,k||d,c>_abab*t1_bb(c,k)*t3_abbabb(d,a,b,l,j,i)
doubles_res += -1.000000000000 * einsum('lkdc,ck,dablji->abij', g_abab[oa, ob, va, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <l,k||c,d>_bbbb*t1_bb(c,k)*t3_bbbbbb(d,a,b,i,j,l)
doubles_res += -1.000000000000 * einsum('lkcd,ck,dabijl->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 P(i,j)<k,l||d,c>_abab*t1_bb(c,j)*t3_abbabb(d,a,b,k,i,l)
contracted_intermediate = -0.500000000000 * einsum('kldc,cj,dabkil->abij', g_abab[oa, ob, va, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(i,j)<l,k||d,c>_abab*t1_bb(c,j)*t3_abbabb(d,a,b,l,k,i)
contracted_intermediate =  0.500000000000 * einsum('lkdc,cj,dablki->abij', g_abab[oa, ob, va, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -0.500000000000 P(i,j)<k,l||c,d>_bbbb*t1_bb(c,j)*t3_bbbbbb(d,a,b,i,k,l)
contracted_intermediate = -0.500000000000 * einsum('klcd,cj,dabikl->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(a,b)<l,k||d,c>_abab*t1_bb(a,k)*t3_abbabb(d,c,b,l,j,i)
contracted_intermediate =  0.500000000000 * einsum('lkdc,ak,dcblji->abij', g_abab[oa, ob, va, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  0.500000000000 P(a,b)<l,k||c,d>_abab*t1_bb(a,k)*t3_abbabb(c,d,b,l,j,i)
contracted_intermediate =  0.500000000000 * einsum('lkcd,ak,cdblji->abij', g_abab[oa, ob, va, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<l,k||d,c>_bbbb*t1_bb(a,k)*t3_bbbbbb(d,c,b,i,j,l)
contracted_intermediate = -0.500000000000 * einsum('lkdc,ak,dcbijl->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -1.000000000000 <l,k||i,j>_bbbb*t1_bb(a,k)*t1_bb(b,l)
doubles_res += -1.000000000000 * einsum('lkij,ak,bl->abij', g_bbbb[ob, ob, ob, ob], t1_bb, t1_bb, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 P(i,j)*P(a,b)<k,a||c,j>_bbbb*t1_bb(b,k)*t1_bb(c,i)
contracted_intermediate =  1.000000000000 * einsum('kacj,bk,ci->abij', g_bbbb[ob, vb, vb, ob], t1_bb, t1_bb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	 -1.000000000000 <a,b||d,c>_bbbb*t1_bb(c,i)*t1_bb(d,j)
doubles_res += -1.000000000000 * einsum('abdc,ci,dj->abij', g_bbbb[vb, vb, vb, vb], t1_bb, t1_bb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 P(i,j)<k,l||d,c>_abab*t2_bbbb(a,b,i,l)*t2_abab(d,c,k,j)
contracted_intermediate = -0.500000000000 * einsum('kldc,abil,dckj->abij', g_abab[oa, ob, va, vb], t2_bbbb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -0.500000000000 P(i,j)<k,l||c,d>_abab*t2_bbbb(a,b,i,l)*t2_abab(c,d,k,j)
contracted_intermediate = -0.500000000000 * einsum('klcd,abil,cdkj->abij', g_abab[oa, ob, va, vb], t2_bbbb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -0.500000000000 P(i,j)<l,k||d,c>_bbbb*t2_bbbb(a,b,i,l)*t2_bbbb(d,c,j,k)
contracted_intermediate = -0.500000000000 * einsum('lkdc,abil,dcjk->abij', g_bbbb[ob, ob, vb, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.250000000000 <k,l||d,c>_bbbb*t2_bbbb(a,b,k,l)*t2_bbbb(d,c,i,j)
doubles_res +=  0.250000000000 * einsum('kldc,abkl,dcij->abij', g_bbbb[ob, ob, vb, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -0.500000000000 P(a,b)<k,l||c,d>_abab*t2_abab(c,a,k,l)*t2_bbbb(d,b,i,j)
contracted_intermediate = -0.500000000000 * einsum('klcd,cakl,dbij->abij', g_abab[oa, ob, va, vb], t2_abab, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<l,k||c,d>_abab*t2_abab(c,a,l,k)*t2_bbbb(d,b,i,j)
contracted_intermediate = -0.500000000000 * einsum('lkcd,calk,dbij->abij', g_abab[oa, ob, va, vb], t2_abab, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<k,l||c,d>_bbbb*t2_bbbb(c,a,k,l)*t2_bbbb(d,b,i,j)
contracted_intermediate = -0.500000000000 * einsum('klcd,cakl,dbij->abij', g_bbbb[ob, ob, vb, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(i,j)<l,k||c,d>_aaaa*t2_abab(c,a,k,j)*t2_abab(d,b,l,i)
contracted_intermediate =  1.000000000000 * einsum('lkcd,cakj,dbli->abij', g_aaaa[oa, oa, va, va], t2_abab, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(i,j)<k,l||c,d>_abab*t2_abab(c,a,k,j)*t2_bbbb(d,b,i,l)
contracted_intermediate =  1.000000000000 * einsum('klcd,cakj,dbil->abij', g_abab[oa, ob, va, vb], t2_abab, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(i,j)<l,k||d,c>_abab*t2_bbbb(c,a,j,k)*t2_abab(d,b,l,i)
contracted_intermediate =  1.000000000000 * einsum('lkdc,cajk,dbli->abij', g_abab[oa, ob, va, vb], t2_bbbb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(i,j)<l,k||c,d>_bbbb*t2_bbbb(c,a,j,k)*t2_bbbb(d,b,i,l)
contracted_intermediate =  1.000000000000 * einsum('lkcd,cajk,dbil->abij', g_bbbb[ob, ob, vb, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<k,l||c,d>_abab*t1_aa(c,k)*t1_bb(d,j)*t2_bbbb(a,b,i,l)
contracted_intermediate = -1.000000000000 * einsum('klcd,ck,dj,abil->abij', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(i,j)<l,k||c,d>_bbbb*t1_bb(c,k)*t1_bb(d,j)*t2_bbbb(a,b,i,l)
contracted_intermediate =  1.000000000000 * einsum('lkcd,ck,dj,abil->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<k,l||c,d>_abab*t1_bb(a,l)*t1_aa(c,k)*t2_bbbb(d,b,i,j)
contracted_intermediate = -1.000000000000 * einsum('klcd,al,ck,dbij->abij', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(a,b)<l,k||c,d>_bbbb*t1_bb(a,l)*t1_bb(c,k)*t2_bbbb(d,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('lkcd,al,ck,dbij->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -0.500000000000 <k,l||d,c>_bbbb*t1_bb(c,i)*t1_bb(d,j)*t2_bbbb(a,b,k,l)
doubles_res += -0.500000000000 * einsum('kldc,ci,dj,abkl->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 P(i,j)*P(a,b)<l,k||d,c>_abab*t1_bb(a,k)*t1_bb(c,j)*t2_abab(d,b,l,i)
contracted_intermediate =  1.000000000000 * einsum('lkdc,ak,cj,dbli->abij', g_abab[oa, ob, va, vb], t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  1.000000000000 P(i,j)*P(a,b)<l,k||c,d>_bbbb*t1_bb(a,k)*t1_bb(c,j)*t2_bbbb(d,b,i,l)
contracted_intermediate =  1.000000000000 * einsum('lkcd,ak,cj,dbil->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	 -0.500000000000 <l,k||d,c>_bbbb*t1_bb(a,k)*t1_bb(b,l)*t2_bbbb(d,c,i,j)
doubles_res += -0.500000000000 * einsum('lkdc,ak,bl,dcij->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])

#	 -1.000000000000 P(i,j)<l,k||c,j>_bbbb*t1_bb(a,k)*t1_bb(b,l)*t1_bb(c,i)
contracted_intermediate = -1.000000000000 * einsum('lkcj,ak,bl,ci->abij', g_bbbb[ob, ob, vb, ob], t1_bb, t1_bb, t1_bb, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<k,a||d,c>_bbbb*t1_bb(b,k)*t1_bb(c,i)*t1_bb(d,j)
contracted_intermediate = -1.000000000000 * einsum('kadc,bk,ci,dj->abij', g_bbbb[ob, vb, vb, vb], t1_bb, t1_bb, t1_bb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 <l,k||d,c>_bbbb*t1_bb(a,k)*t1_bb(b,l)*t1_bb(c,i)*t1_bb(d,j)
doubles_res +=  1.000000000000 * einsum('lkdc,ak,bl,ci,dj->abij', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t1_bb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])

return doubles_res

