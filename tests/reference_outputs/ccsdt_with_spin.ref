triples_res +=  1.000000000000 * einsum('mlde,am,dl,ebcijk->abcijk', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t3_abbabb, optimize=['einsum_path', (0, 2), (0, 2), (0, 1)])

#	 -1.000000000000 <m,l||e,d>_abab*t1_aa(a,m)*t1_bb(d,l)*t3_abbabb(e,b,c,i,j,k)
triples_res += -1.000000000000 * einsum('mled,am,dl,ebcijk->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 2), (0, 2), (0, 1)])

#	 -1.000000000000 <m,l||d,e>_aaaa*t1_aa(d,l)*t1_aa(e,i)*t3_abbabb(a,b,c,m,k,j)
triples_res += -1.000000000000 * einsum('mlde,dl,ei,abcmkj->abcijk', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t3_abbabb, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <m,l||e,d>_abab*t1_bb(d,l)*t1_aa(e,i)*t3_abbabb(a,b,c,m,k,j)
triples_res +=  1.000000000000 * einsum('mled,dl,ei,abcmkj->abcijk', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t3_abbabb, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <l,m||d,e>_abab*t1_aa(d,l)*t1_bb(e,j)*t3_abbabb(a,b,c,i,k,m)
triples_res +=  1.000000000000 * einsum('lmde,dl,ej,abcikm->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	 -1.000000000000 <m,l||d,e>_bbbb*t1_bb(d,l)*t1_bb(e,j)*t3_abbabb(a,b,c,i,k,m)
triples_res += -1.000000000000 * einsum('mlde,dl,ej,abcikm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	 -1.000000000000 <l,m||d,e>_abab*t1_aa(d,l)*t1_bb(e,k)*t3_abbabb(a,b,c,i,j,m)
triples_res += -1.000000000000 * einsum('lmde,dl,ek,abcijm->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 <m,l||d,e>_bbbb*t1_bb(d,l)*t1_bb(e,k)*t3_abbabb(a,b,c,i,j,m)
triples_res +=  1.000000000000 * einsum('mlde,dl,ek,abcijm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	 -1.000000000000 <l,m||d,e>_abab*t1_aa(a,l)*t1_bb(c,m)*t1_aa(d,i)*t2_bbbb(e,b,j,k)
triples_res += -1.000000000000 * einsum('lmde,al,cm,di,ebjk->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, t2_bbbb, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <l,m||e,d>_abab*t1_aa(a,l)*t1_bb(c,m)*t1_bb(d,j)*t2_abab(e,b,i,k)
triples_res += -1.000000000000 * einsum('lmed,al,cm,dj,ebik->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <m,l||d,e>_bbbb*t1_bb(b,l)*t1_bb(c,m)*t1_bb(d,j)*t2_abab(a,e,i,k)
triples_res += -1.000000000000 * einsum('mlde,bl,cm,dj,aeik->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_abab, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])

#	  1.000000000000 <l,m||d,e>_abab*t1_aa(a,l)*t1_bb(b,m)*t1_aa(d,i)*t2_bbbb(e,c,j,k)
triples_res +=  1.000000000000 * einsum('lmde,al,bm,di,ecjk->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, t2_bbbb, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

