def ccsdt_t2_abab_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* b a e(-T) H e(T) | 0> :

#	 -1.000000000000 f_aa(k,i)*t2_abab(a,b,k,j)
doubles_res += -1.000000000000 * einsum('ki,abkj->abij', f_aa[oa, oa], t2_abab)

#	 -1.000000000000 f_bb(k,j)*t2_abab(a,b,i,k)
doubles_res += -1.000000000000 * einsum('kj,abik->abij', f_bb[ob, ob], t2_abab)

#	  1.000000000000 f_aa(a,c)*t2_abab(c,b,i,j)
doubles_res +=  1.000000000000 * einsum('ac,cbij->abij', f_aa[va, va], t2_abab)

#	  1.000000000000 f_bb(b,c)*t2_abab(a,c,i,j)
doubles_res +=  1.000000000000 * einsum('bc,acij->abij', f_bb[vb, vb], t2_abab)

#	 -1.000000000000 f_aa(k,c)*t3_aabaab(c,a,b,i,k,j)
doubles_res += -1.000000000000 * einsum('kc,cabikj->abij', f_aa[oa, va], t3_aabaab)

#	 -1.000000000000 f_bb(k,c)*t3_abbabb(a,c,b,i,j,k)
doubles_res += -1.000000000000 * einsum('kc,acbijk->abij', f_bb[ob, vb], t3_abbabb)

#	 -1.000000000000 f_aa(k,c)*t1_aa(a,k)*t2_abab(c,b,i,j)
doubles_res += -1.000000000000 * einsum('kc,ak,cbij->abij', f_aa[oa, va], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 f_bb(k,c)*t1_bb(b,k)*t2_abab(a,c,i,j)
doubles_res += -1.000000000000 * einsum('kc,bk,acij->abij', f_bb[ob, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 f_aa(k,c)*t1_aa(c,i)*t2_abab(a,b,k,j)
doubles_res += -1.000000000000 * einsum('kc,ci,abkj->abij', f_aa[oa, va], t1_aa, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 f_bb(k,c)*t1_bb(c,j)*t2_abab(a,b,i,k)
doubles_res += -1.000000000000 * einsum('kc,cj,abik->abij', f_bb[ob, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <a,b||i,j>_abab
doubles_res +=  1.000000000000 * einsum('abij->abij', g_abab[va, vb, oa, ob])

#	 -1.000000000000 <a,k||i,j>_abab*t1_bb(b,k)
doubles_res += -1.000000000000 * einsum('akij,bk->abij', g_abab[va, ob, oa, ob], t1_bb)

#	 -1.000000000000 <k,b||i,j>_abab*t1_aa(a,k)
doubles_res += -1.000000000000 * einsum('kbij,ak->abij', g_abab[oa, vb, oa, ob], t1_aa)

#	  1.000000000000 <a,b||i,c>_abab*t1_bb(c,j)
doubles_res +=  1.000000000000 * einsum('abic,cj->abij', g_abab[va, vb, oa, vb], t1_bb)

#	  1.000000000000 <a,b||c,j>_abab*t1_aa(c,i)
doubles_res +=  1.000000000000 * einsum('abcj,ci->abij', g_abab[va, vb, va, ob], t1_aa)

#	  0.500000000000 <k,l||i,j>_abab*t2_abab(a,b,k,l)
doubles_res +=  0.500000000000 * einsum('klij,abkl->abij', g_abab[oa, ob, oa, ob], t2_abab)

#	  0.500000000000 <l,k||i,j>_abab*t2_abab(a,b,l,k)
doubles_res +=  0.500000000000 * einsum('lkij,ablk->abij', g_abab[oa, ob, oa, ob], t2_abab)

#	  1.000000000000 <a,k||i,c>_aaaa*t2_abab(c,b,k,j)
doubles_res +=  1.000000000000 * einsum('akic,cbkj->abij', g_aaaa[va, oa, oa, va], t2_abab)

#	 -1.000000000000 <a,k||i,c>_abab*t2_bbbb(c,b,j,k)
doubles_res += -1.000000000000 * einsum('akic,cbjk->abij', g_abab[va, ob, oa, vb], t2_bbbb)

#	 -1.000000000000 <k,b||i,c>_abab*t2_abab(a,c,k,j)
doubles_res += -1.000000000000 * einsum('kbic,ackj->abij', g_abab[oa, vb, oa, vb], t2_abab)

#	 -1.000000000000 <a,k||c,j>_abab*t2_abab(c,b,i,k)
doubles_res += -1.000000000000 * einsum('akcj,cbik->abij', g_abab[va, ob, va, ob], t2_abab)

#	 -1.000000000000 <k,b||c,j>_abab*t2_aaaa(c,a,i,k)
doubles_res += -1.000000000000 * einsum('kbcj,caik->abij', g_abab[oa, vb, va, ob], t2_aaaa)

#	  1.000000000000 <b,k||j,c>_bbbb*t2_abab(a,c,i,k)
doubles_res +=  1.000000000000 * einsum('bkjc,acik->abij', g_bbbb[vb, ob, ob, vb], t2_abab)

#	  0.500000000000 <a,b||d,c>_abab*t2_abab(d,c,i,j)
doubles_res +=  0.500000000000 * einsum('abdc,dcij->abij', g_abab[va, vb, va, vb], t2_abab)

#	  0.500000000000 <a,b||c,d>_abab*t2_abab(c,d,i,j)
doubles_res +=  0.500000000000 * einsum('abcd,cdij->abij', g_abab[va, vb, va, vb], t2_abab)

#	 -0.500000000000 <k,l||i,c>_aaaa*t3_aabaab(c,a,b,l,k,j)
doubles_res += -0.500000000000 * einsum('klic,cablkj->abij', g_aaaa[oa, oa, oa, va], t3_aabaab)

#	  0.500000000000 <k,l||i,c>_abab*t3_abbabb(a,c,b,k,j,l)
doubles_res +=  0.500000000000 * einsum('klic,acbkjl->abij', g_abab[oa, ob, oa, vb], t3_abbabb)

#	 -0.500000000000 <l,k||i,c>_abab*t3_abbabb(a,c,b,l,k,j)
doubles_res += -0.500000000000 * einsum('lkic,acblkj->abij', g_abab[oa, ob, oa, vb], t3_abbabb)

#	  0.500000000000 <k,l||c,j>_abab*t3_aabaab(c,a,b,i,k,l)
doubles_res +=  0.500000000000 * einsum('klcj,cabikl->abij', g_abab[oa, ob, va, ob], t3_aabaab)

#	  0.500000000000 <l,k||c,j>_abab*t3_aabaab(c,a,b,i,l,k)
doubles_res +=  0.500000000000 * einsum('lkcj,cabilk->abij', g_abab[oa, ob, va, ob], t3_aabaab)

#	  0.500000000000 <k,l||j,c>_bbbb*t3_abbabb(a,c,b,i,k,l)
doubles_res +=  0.500000000000 * einsum('kljc,acbikl->abij', g_bbbb[ob, ob, ob, vb], t3_abbabb)

#	  0.500000000000 <a,k||d,c>_aaaa*t3_aabaab(d,c,b,i,k,j)
doubles_res +=  0.500000000000 * einsum('akdc,dcbikj->abij', g_aaaa[va, oa, va, va], t3_aabaab)

#	 -0.500000000000 <a,k||d,c>_abab*t3_abbabb(d,c,b,i,j,k)
doubles_res += -0.500000000000 * einsum('akdc,dcbijk->abij', g_abab[va, ob, va, vb], t3_abbabb)

#	 -0.500000000000 <a,k||c,d>_abab*t3_abbabb(c,d,b,i,j,k)
doubles_res += -0.500000000000 * einsum('akcd,cdbijk->abij', g_abab[va, ob, va, vb], t3_abbabb)

#	 -0.500000000000 <k,b||d,c>_abab*t3_aabaab(d,a,c,i,k,j)
doubles_res += -0.500000000000 * einsum('kbdc,dacikj->abij', g_abab[oa, vb, va, vb], t3_aabaab)

#	  0.500000000000 <k,b||c,d>_abab*t3_aabaab(a,c,d,i,k,j)
doubles_res +=  0.500000000000 * einsum('kbcd,acdikj->abij', g_abab[oa, vb, va, vb], t3_aabaab)

#	 -0.500000000000 <b,k||d,c>_bbbb*t3_abbabb(a,c,d,i,j,k)
doubles_res += -0.500000000000 * einsum('bkdc,acdijk->abij', g_bbbb[vb, ob, vb, vb], t3_abbabb)

#	  1.000000000000 <l,k||i,c>_aaaa*t1_aa(a,k)*t2_abab(c,b,l,j)
doubles_res +=  1.000000000000 * einsum('lkic,ak,cblj->abij', g_aaaa[oa, oa, oa, va], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <k,l||i,c>_abab*t1_aa(a,k)*t2_bbbb(c,b,j,l)
doubles_res +=  1.000000000000 * einsum('klic,ak,cbjl->abij', g_abab[oa, ob, oa, vb], t1_aa, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <l,k||i,c>_abab*t1_bb(b,k)*t2_abab(a,c,l,j)
doubles_res +=  1.000000000000 * einsum('lkic,bk,aclj->abij', g_abab[oa, ob, oa, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 <k,l||c,j>_abab*t1_aa(a,k)*t2_abab(c,b,i,l)
doubles_res +=  1.000000000000 * einsum('klcj,ak,cbil->abij', g_abab[oa, ob, va, ob], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <l,k||c,j>_abab*t1_bb(b,k)*t2_aaaa(c,a,i,l)
doubles_res +=  1.000000000000 * einsum('lkcj,bk,cail->abij', g_abab[oa, ob, va, ob], t1_bb, t2_aaaa, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 <l,k||j,c>_bbbb*t1_bb(b,k)*t2_abab(a,c,i,l)
doubles_res +=  1.000000000000 * einsum('lkjc,bk,acil->abij', g_bbbb[ob, ob, ob, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	  0.500000000000 <k,l||i,c>_abab*t1_bb(c,j)*t2_abab(a,b,k,l)
doubles_res +=  0.500000000000 * einsum('klic,cj,abkl->abij', g_abab[oa, ob, oa, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  0.500000000000 <l,k||i,c>_abab*t1_bb(c,j)*t2_abab(a,b,l,k)
doubles_res +=  0.500000000000 * einsum('lkic,cj,ablk->abij', g_abab[oa, ob, oa, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  0.500000000000 <k,l||c,j>_abab*t1_aa(c,i)*t2_abab(a,b,k,l)
doubles_res +=  0.500000000000 * einsum('klcj,ci,abkl->abij', g_abab[oa, ob, va, ob], t1_aa, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	  0.500000000000 <l,k||c,j>_abab*t1_aa(c,i)*t2_abab(a,b,l,k)
doubles_res +=  0.500000000000 * einsum('lkcj,ci,ablk->abij', g_abab[oa, ob, va, ob], t1_aa, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 <l,k||i,c>_aaaa*t1_aa(c,k)*t2_abab(a,b,l,j)
doubles_res += -1.000000000000 * einsum('lkic,ck,ablj->abij', g_aaaa[oa, oa, oa, va], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <l,k||i,c>_abab*t1_bb(c,k)*t2_abab(a,b,l,j)
doubles_res += -1.000000000000 * einsum('lkic,ck,ablj->abij', g_abab[oa, ob, oa, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <k,l||c,j>_abab*t1_aa(c,k)*t2_abab(a,b,i,l)
doubles_res += -1.000000000000 * einsum('klcj,ck,abil->abij', g_abab[oa, ob, va, ob], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <l,k||j,c>_bbbb*t1_bb(c,k)*t2_abab(a,b,i,l)
doubles_res += -1.000000000000 * einsum('lkjc,ck,abil->abij', g_bbbb[ob, ob, ob, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 <a,k||d,c>_abab*t1_bb(b,k)*t2_abab(d,c,i,j)
doubles_res += -0.500000000000 * einsum('akdc,bk,dcij->abij', g_abab[va, ob, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -0.500000000000 <a,k||c,d>_abab*t1_bb(b,k)*t2_abab(c,d,i,j)
doubles_res += -0.500000000000 * einsum('akcd,bk,cdij->abij', g_abab[va, ob, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -0.500000000000 <k,b||d,c>_abab*t1_aa(a,k)*t2_abab(d,c,i,j)
doubles_res += -0.500000000000 * einsum('kbdc,ak,dcij->abij', g_abab[oa, vb, va, vb], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 <k,b||c,d>_abab*t1_aa(a,k)*t2_abab(c,d,i,j)
doubles_res += -0.500000000000 * einsum('kbcd,ak,cdij->abij', g_abab[oa, vb, va, vb], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

