#	  1.000000000000 P(i,j)<m,l||d,e>_bbbb*t1_bb(d,l)*t1_bb(e,i)*t3_bbbbbb(a,b,c,j,k,m)
contracted_intermediate =  1.000000000000 * einsum('mlde,dl,ei,abcjkm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 <l,m||d,e>_abab*t1_aa(d,l)*t1_bb(e,k)*t3_bbbbbb(a,b,c,i,j,m)
triples_res += -1.000000000000 * einsum('lmde,dl,ek,abcijm->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 <m,l||d,e>_bbbb*t1_bb(d,l)*t1_bb(e,k)*t3_bbbbbb(a,b,c,i,j,m)
triples_res +=  1.000000000000 * einsum('mlde,dl,ek,abcijm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 P(i,j)*P(a,b)<m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(c,m)*t1_bb(d,i)*t2_bbbb(e,b,j,k)
contracted_intermediate =  1.000000000000 * einsum('mlde,al,cm,di,ebjk->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(b,m)*t1_bb(d,i)*t2_bbbb(e,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('mlde,al,bm,di,ecjk->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  1.000000000000 P(j,k)*P(b,c)<m,l||e,d>_bbbb*t1_bb(b,l)*t1_bb(d,i)*t1_bb(e,j)*t2_bbbb(a,c,k,m)
contracted_intermediate =  1.000000000000 * einsum('mled,bl,di,ej,ackm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(j,k)<m,l||e,d>_bbbb*t1_bb(a,l)*t1_bb(d,i)*t1_bb(e,j)*t2_bbbb(b,c,k,m)
contracted_intermediate = -1.000000000000 * einsum('mled,al,di,ej,bckm->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	  1.000000000000 P(a,b)<m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(c,m)*t1_bb(d,k)*t2_bbbb(e,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('mlde,al,cm,dk,ebij->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 <m,l||d,e>_bbbb*t1_bb(a,l)*t1_bb(b,m)*t1_bb(d,k)*t2_bbbb(e,c,i,j)
triples_res += -1.000000000000 * einsum('mlde,al,bm,dk,ecij->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])

#	  1.000000000000 P(b,c)<m,l||e,d>_bbbb*t1_bb(b,l)*t1_bb(d,j)*t1_bb(e,k)*t2_bbbb(a,c,i,m)
contracted_intermediate =  1.000000000000 * einsum('mled,bl,dj,ek,acim->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 <m,l||e,d>_bbbb*t1_bb(a,l)*t1_bb(d,j)*t1_bb(e,k)*t2_bbbb(b,c,i,m)
triples_res += -1.000000000000 * einsum('mled,al,dj,ek,bcim->abcijk', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (1, 3), (0, 2), (0, 1)])

return triples_res

