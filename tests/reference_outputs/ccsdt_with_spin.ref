def ccsdt_t3_bbbbbb_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* k* c b a e(-T) H e(T) | 0> :

#	 -1.000000000000 P(i,j)f_bb(l,i)*t3_bbbbbb(a,b,c,j,k,l)
contracted_intermediate = -1.000000000000 * einsum('li,abcjkl->abcijk', f_bb[ob, ob], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,k)*t3_bbbbbb(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('lk,abcijl->abcijk', f_bb[ob, ob], t3_bbbbbb)

#	 -1.000000000000 P(b,c)f_bb(b,d)*t3_bbbbbb(d,a,c,i,j,k)
contracted_intermediate = -1.000000000000 * einsum('bd,dacijk->abcijk', f_bb[vb, vb], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	  1.000000000000 f_bb(a,d)*t3_bbbbbb(d,b,c,i,j,k)
triples_res +=  1.000000000000 * einsum('ad,dbcijk->abcijk', f_bb[vb, vb], t3_bbbbbb)

#	  1.000000000000 P(b,c)f_bb(l,d)*t1_bb(b,l)*t3_bbbbbb(d,a,c,i,j,k)
contracted_intermediate =  1.000000000000 * einsum('ld,bl,dacijk->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,d)*t1_bb(a,l)*t3_bbbbbb(d,b,c,i,j,k)
triples_res += -1.000000000000 * einsum('ld,al,dbcijk->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 P(i,j)f_bb(l,d)*t1_bb(d,i)*t3_bbbbbb(a,b,c,j,k,l)
contracted_intermediate = -1.000000000000 * einsum('ld,di,abcjkl->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,d)*t1_bb(d,k)*t3_bbbbbb(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('ld,dk,abcijl->abcijk', f_bb[ob, vb], t1_bb, t3_bbbbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 P(j,k)*P(b,c)f_bb(l,d)*t2_bbbb(a,b,j,l)*t2_bbbb(d,c,i,k)
contracted_intermediate =  1.000000000000 * einsum('ld,abjl,dcik->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(b,c)f_bb(l,d)*t2_bbbb(a,b,i,l)*t2_bbbb(d,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('ld,abil,dcjk->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 P(j,k)f_bb(l,d)*t2_bbbb(d,a,i,j)*t2_bbbb(b,c,k,l)
contracted_intermediate = -1.000000000000 * einsum('ld,daij,bckl->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,d)*t2_bbbb(d,a,j,k)*t2_bbbb(b,c,i,l)
triples_res += -1.000000000000 * einsum('ld,dajk,bcil->abcijk', f_bb[ob, vb], t2_bbbb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 P(j,k)*P(b,c)<b,l||i,j>_bbbb*t2_bbbb(a,c,k,l)
contracted_intermediate = -1.000000000000 * einsum('blij,ackl->abcijk', g_bbbb[vb, ob, ob, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(b,c)<b,l||j,k>_bbbb*t2_bbbb(a,c,i,l)
contracted_intermediate = -1.000000000000 * einsum('bljk,acil->abcijk', g_bbbb[vb, ob, ob, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	  1.000000000000 P(j,k)<a,l||i,j>_bbbb*t2_bbbb(b,c,k,l)
contracted_intermediate =  1.000000000000 * einsum('alij,bckl->abcijk', g_bbbb[vb, ob, ob, ob], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	  1.000000000000 <a,l||j,k>_bbbb*t2_bbbb(b,c,i,l)
triples_res +=  1.000000000000 * einsum('aljk,bcil->abcijk', g_bbbb[vb, ob, ob, ob], t2_bbbb)

#	 -1.000000000000 P(i,j)*P(a,b)<a,c||i,d>_bbbb*t2_bbbb(d,b,j,k)
contracted_intermediate = -1.000000000000 * einsum('acid,dbjk->abcijk', g_bbbb[vb, vb, ob, vb], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<a,c||k,d>_bbbb*t2_bbbb(d,b,i,j)
contracted_intermediate = -1.000000000000 * einsum('ackd,dbij->abcijk', g_bbbb[vb, vb, ob, vb], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 P(i,j)<a,b||i,d>_bbbb*t2_bbbb(d,c,j,k)
contracted_intermediate =  1.000000000000 * einsum('abid,dcjk->abcijk', g_bbbb[vb, vb, ob, vb], t2_bbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  1.000000000000 <a,b||k,d>_bbbb*t2_bbbb(d,c,i,j)
triples_res +=  1.000000000000 * einsum('abkd,dcij->abcijk', g_bbbb[vb, vb, ob, vb], t2_bbbb)

#	  0.500000000000 P(j,k)<l,m||i,j>_bbbb*t3_bbbbbb(a,b,c,k,l,m)
contracted_intermediate =  0.500000000000 * einsum('lmij,abcklm->abcijk', g_bbbb[ob, ob, ob, ob], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	  0.500000000000 <l,m||j,k>_bbbb*t3_bbbbbb(a,b,c,i,l,m)
triples_res +=  0.500000000000 * einsum('lmjk,abcilm->abcijk', g_bbbb[ob, ob, ob, ob], t3_bbbbbb)

#	  1.000000000000 P(i,j)*P(b,c)<l,b||d,i>_abab*t3_abbabb(d,a,c,l,k,j)
contracted_intermediate =  1.000000000000 * einsum('lbdi,daclkj->abcijk', g_abab[oa, vb, va, ob], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbjik', contracted_intermediate) 

#	 -1.000000000000 P(i,j)*P(b,c)<b,l||i,d>_bbbb*t3_bbbbbb(d,a,c,j,k,l)
contracted_intermediate = -1.000000000000 * einsum('blid,dacjkl->abcijk', g_bbbb[vb, ob, ob, vb], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbjik', contracted_intermediate) 

#	  1.000000000000 P(b,c)<l,b||d,k>_abab*t3_abbabb(d,a,c,l,j,i)
contracted_intermediate =  1.000000000000 * einsum('lbdk,daclji->abcijk', g_abab[oa, vb, va, ob], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 P(b,c)<b,l||k,d>_bbbb*t3_bbbbbb(d,a,c,i,j,l)
contracted_intermediate = -1.000000000000 * einsum('blkd,dacijl->abcijk', g_bbbb[vb, ob, ob, vb], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<l,a||d,i>_abab*t3_abbabb(d,b,c,l,k,j)
contracted_intermediate = -1.000000000000 * einsum('ladi,dbclkj->abcijk', g_abab[oa, vb, va, ob], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  1.000000000000 P(i,j)<a,l||i,d>_bbbb*t3_bbbbbb(d,b,c,j,k,l)
contracted_intermediate =  1.000000000000 * einsum('alid,dbcjkl->abcijk', g_bbbb[vb, ob, ob, vb], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 <l,a||d,k>_abab*t3_abbabb(d,b,c,l,j,i)
triples_res += -1.000000000000 * einsum('ladk,dbclji->abcijk', g_abab[oa, vb, va, ob], t3_abbabb)

#	  1.000000000000 <a,l||k,d>_bbbb*t3_bbbbbb(d,b,c,i,j,l)
triples_res +=  1.000000000000 * einsum('alkd,dbcijl->abcijk', g_bbbb[vb, ob, ob, vb], t3_bbbbbb)

#	 -0.500000000000 P(a,b)<a,c||e,d>_bbbb*t3_bbbbbb(e,d,b,i,j,k)
contracted_intermediate = -0.500000000000 * einsum('aced,edbijk->abcijk', g_bbbb[vb, vb, vb, vb], t3_bbbbbb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  0.500000000000 <a,b||e,d>_bbbb*t3_bbbbbb(e,d,c,i,j,k)
triples_res +=  0.500000000000 * einsum('abed,edcijk->abcijk', g_bbbb[vb, vb, vb, vb], t3_bbbbbb)

#	 -1.000000000000 P(j,k)*P(b,c)<m,l||i,j>_bbbb*t1_bb(b,l)*t2_bbbb(a,c,k,m)
contracted_intermediate = -1.000000000000 * einsum('mlij,bl,ackm->abcijk', g_bbbb[ob, ob, ob, ob], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	  1.000000000000 P(j,k)<m,l||i,j>_bbbb*t1_bb(a,l)*t2_bbbb(b,c,k,m)
contracted_intermediate =  1.000000000000 * einsum('mlij,al,bckm->abcijk', g_bbbb[ob, ob, ob, ob], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
