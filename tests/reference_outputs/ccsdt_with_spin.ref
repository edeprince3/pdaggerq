['+1.000', 'P(b,c)', '<m,l||e,d>_bbbb', 't1_bb(b,l)', 't1_bb(d,j)', 't1_bb(e,k)', 't2_abab(a,c,i,m)']

def ccsdt_t3_abbabb_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* k* c b a e(-T) H e(T) | 0> :

#	  1.000000000000 f_aa(l,i)*t3_abbabb(a,b,c,l,k,j)
triples_res +=  1.000000000000 * einsum('li,abclkj->abcijk', f_aa[oa, oa], t3_abbabb)

#	  1.000000000000 f_bb(l,j)*t3_abbabb(a,b,c,i,k,l)
triples_res +=  1.000000000000 * einsum('lj,abcikl->abcijk', f_bb[ob, ob], t3_abbabb)

#	 -1.000000000000 f_bb(l,k)*t3_abbabb(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('lk,abcijl->abcijk', f_bb[ob, ob], t3_abbabb)

#	  1.000000000000 P(b,c)f_bb(b,d)*t3_abbabb(a,d,c,i,j,k)
contracted_intermediate =  1.000000000000 * einsum('bd,adcijk->abcijk', f_bb[vb, vb], t3_abbabb)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	  1.000000000000 f_aa(a,d)*t3_abbabb(d,b,c,i,j,k)
triples_res +=  1.000000000000 * einsum('ad,dbcijk->abcijk', f_aa[va, va], t3_abbabb)

#	 -1.000000000000 P(b,c)f_bb(l,d)*t1_bb(b,l)*t3_abbabb(a,d,c,i,j,k)
contracted_intermediate = -1.000000000000 * einsum('ld,bl,adcijk->abcijk', f_bb[ob, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 f_aa(l,d)*t1_aa(a,l)*t3_abbabb(d,b,c,i,j,k)
triples_res += -1.000000000000 * einsum('ld,al,dbcijk->abcijk', f_aa[oa, va], t1_aa, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 f_aa(l,d)*t1_aa(d,i)*t3_abbabb(a,b,c,l,k,j)
triples_res +=  1.000000000000 * einsum('ld,di,abclkj->abcijk', f_aa[oa, va], t1_aa, t3_abbabb, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 f_bb(l,d)*t1_bb(d,j)*t3_abbabb(a,b,c,i,k,l)
triples_res +=  1.000000000000 * einsum('ld,dj,abcikl->abcijk', f_bb[ob, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 f_bb(l,d)*t1_bb(d,k)*t3_abbabb(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('ld,dk,abcijl->abcijk', f_bb[ob, vb], t1_bb, t3_abbabb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 P(j,k)*P(b,c)f_aa(l,d)*t2_abab(a,b,l,j)*t2_abab(d,c,i,k)
contracted_intermediate = -1.000000000000 * einsum('ld,ablj,dcik->abcijk', f_aa[oa, va], t2_abab, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(b,c)f_bb(l,d)*t2_abab(a,b,i,l)*t2_bbbb(d,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('ld,abil,dcjk->abcijk', f_bb[ob, vb], t2_abab, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	  1.000000000000 P(j,k)f_bb(l,d)*t2_abab(a,d,i,j)*t2_bbbb(b,c,k,l)
contracted_intermediate =  1.000000000000 * einsum('ld,adij,bckl->abcijk', f_bb[ob, vb], t2_abab, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -1.000000000000 P(j,k)*P(b,c)<l,b||i,j>_abab*t2_abab(a,c,l,k)
contracted_intermediate = -1.000000000000 * einsum('lbij,aclk->abcijk', g_abab[oa, vb, oa, ob], t2_abab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(b,c)<b,l||j,k>_bbbb*t2_abab(a,c,i,l)
contracted_intermediate = -1.000000000000 * einsum('bljk,acil->abcijk', g_bbbb[vb, ob, ob, ob], t2_abab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	  1.000000000000 P(j,k)<a,l||i,j>_abab*t2_bbbb(b,c,k,l)
contracted_intermediate =  1.000000000000 * einsum('alij,bckl->abcijk', g_abab[va, ob, oa, ob], t2_bbbb)
