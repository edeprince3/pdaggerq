#	  1.000000000000 P(i,j)*P(a,b)<l,m||d,e>_abab*t1_aa(a,l)*t1_bb(c,m)*t1_aa(d,i)*t2_abab(b,e,j,k)
contracted_intermediate =  1.000000000000 * einsum('lmde,al,cm,di,bejk->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<m,l||d,e>_aaaa*t1_aa(a,l)*t1_aa(b,m)*t1_aa(d,i)*t2_abab(e,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('mlde,al,bm,di,ecjk->abcijk', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 <m,l||e,d>_aaaa*t1_aa(b,l)*t1_aa(d,i)*t1_aa(e,j)*t2_abab(a,c,m,k)
triples_res += -1.000000000000 * einsum('mled,bl,di,ej,acmk->abcijk', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <l,m||d,e>_abab*t1_aa(b,l)*t1_aa(d,i)*t1_bb(e,k)*t2_abab(a,c,j,m)
triples_res += -1.000000000000 * einsum('lmde,bl,di,ek,acjm->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <m,l||d,e>_abab*t1_bb(c,l)*t1_aa(d,i)*t1_bb(e,k)*t2_aaaa(a,b,j,m)
triples_res += -1.000000000000 * einsum('mlde,cl,di,ek,abjm->abcijk', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t1_bb, t2_aaaa, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])

#	  1.000000000000 <m,l||e,d>_aaaa*t1_aa(a,l)*t1_aa(d,i)*t1_aa(e,j)*t2_abab(b,c,m,k)
triples_res +=  1.000000000000 * einsum('mled,al,di,ej,bcmk->abcijk', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

#	  1.000000000000 <l,m||d,e>_abab*t1_aa(a,l)*t1_aa(d,i)*t1_bb(e,k)*t2_abab(b,c,j,m)
triples_res +=  1.000000000000 * einsum('lmde,al,di,ek,bcjm->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])

#	  1.000000000000 P(a,b)<l,m||e,d>_abab*t1_aa(a,l)*t1_bb(c,m)*t1_bb(d,k)*t2_aaaa(e,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('lmed,al,cm,dk,ebij->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_bb, t2_aaaa, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 <l,m||d,e>_abab*t1_aa(b,l)*t1_aa(d,j)*t1_bb(e,k)*t2_abab(a,c,i,m)
triples_res +=  1.000000000000 * einsum('lmde,bl,dj,ek,acim->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])

#	  1.000000000000 <m,l||d,e>_abab*t1_bb(c,l)*t1_aa(d,j)*t1_bb(e,k)*t2_aaaa(a,b,i,m)
triples_res +=  1.000000000000 * einsum('mlde,cl,dj,ek,abim->abcijk', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t1_bb, t2_aaaa, optimize=['einsum_path', (0, 3), (2, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <l,m||d,e>_abab*t1_aa(a,l)*t1_aa(d,j)*t1_bb(e,k)*t2_abab(b,c,i,m)
triples_res += -1.000000000000 * einsum('lmde,al,dj,ek,bcim->abcijk', g_abab[oa, ob, va, vb], t1_aa, t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 3), (0, 2), (0, 1)])

return triples_res

