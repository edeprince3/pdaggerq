#	  1.000000000000 <l,k||c,d>_aaaa*t1_aa(a,k)*t1_aa(c,i)*t2_abab(d,b,l,j)
doubles_res +=  1.000000000000 * einsum('lkcd,ak,ci,dblj->abij', g_aaaa[oa, oa, va, va], t1_aa, t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <k,l||c,d>_abab*t1_aa(a,k)*t1_aa(c,i)*t2_bbbb(d,b,j,l)
doubles_res +=  1.000000000000 * einsum('klcd,ak,ci,dbjl->abij', g_abab[oa, ob, va, vb], t1_aa, t1_aa, t2_bbbb, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <l,k||c,d>_abab*t1_bb(b,k)*t1_aa(c,i)*t2_abab(a,d,l,j)
doubles_res +=  1.000000000000 * einsum('lkcd,bk,ci,adlj->abij', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t2_abab, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])

#	  0.500000000000 <k,l||d,c>_abab*t1_aa(a,k)*t1_bb(b,l)*t2_abab(d,c,i,j)
doubles_res +=  0.500000000000 * einsum('kldc,ak,bl,dcij->abij', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  0.500000000000 <k,l||c,d>_abab*t1_aa(a,k)*t1_bb(b,l)*t2_abab(c,d,i,j)
doubles_res +=  0.500000000000 * einsum('klcd,ak,bl,cdij->abij', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <k,l||c,j>_abab*t1_aa(a,k)*t1_bb(b,l)*t1_aa(c,i)
doubles_res +=  1.000000000000 * einsum('klcj,ak,bl,ci->abij', g_abab[oa, ob, va, ob], t1_aa, t1_bb, t1_aa, optimize=['einsum_path', (0, 1), (0, 2), (0, 1)])

#	  1.000000000000 <k,l||i,c>_abab*t1_aa(a,k)*t1_bb(b,l)*t1_bb(c,j)
doubles_res +=  1.000000000000 * einsum('klic,ak,bl,cj->abij', g_abab[oa, ob, oa, vb], t1_aa, t1_bb, t1_bb, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	 -1.000000000000 <a,k||c,d>_abab*t1_bb(b,k)*t1_aa(c,i)*t1_bb(d,j)
doubles_res += -1.000000000000 * einsum('akcd,bk,ci,dj->abij', g_abab[va, ob, va, vb], t1_bb, t1_aa, t1_bb, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])

#	 -1.000000000000 <k,b||c,d>_abab*t1_aa(a,k)*t1_aa(c,i)*t1_bb(d,j)
doubles_res += -1.000000000000 * einsum('kbcd,ak,ci,dj->abij', g_abab[oa, vb, va, vb], t1_aa, t1_aa, t1_bb, optimize=['einsum_path', (0, 1), (1, 2), (0, 1)])

#	  1.000000000000 <k,l||c,d>_abab*t1_aa(a,k)*t1_bb(b,l)*t1_aa(c,i)*t1_bb(d,j)
doubles_res +=  1.000000000000 * einsum('klcd,ak,bl,ci,dj->abij', g_abab[oa, ob, va, vb], t1_aa, t1_bb, t1_aa, t1_bb, optimize=['einsum_path', (0, 1), (2, 3), (0, 2), (0, 1)])

return doubles_res


