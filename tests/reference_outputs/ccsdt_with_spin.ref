def ccsdt_t1_bb_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* a e(-T) H e(T) | 0> :

#	  1.000000000000 f_bb(a,i)
singles_res +=  1.000000000000 * einsum('ai->ai', f_bb[vb, ob])

#	 -1.000000000000 f_bb(j,i)*t1_bb(a,j)
singles_res += -1.000000000000 * einsum('ji,aj->ai', f_bb[ob, ob], t1_bb)

#	  1.000000000000 f_bb(a,b)*t1_bb(b,i)
singles_res +=  1.000000000000 * einsum('ab,bi->ai', f_bb[vb, vb], t1_bb)

#	  1.000000000000 f_aa(j,b)*t2_abab(b,a,j,i)
singles_res +=  1.000000000000 * einsum('jb,baji->ai', f_aa[oa, va], t2_abab)

#	 -1.000000000000 f_bb(j,b)*t2_bbbb(b,a,i,j)
singles_res += -1.000000000000 * einsum('jb,baij->ai', f_bb[ob, vb], t2_bbbb)

#	 -1.000000000000 f_bb(j,b)*t1_bb(a,j)*t1_bb(b,i)
singles_res += -1.000000000000 * einsum('jb,aj,bi->ai', f_bb[ob, vb], t1_bb, t1_bb, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 <j,a||b,i>_abab*t1_aa(b,j)
singles_res +=  1.000000000000 * einsum('jabi,bj->ai', g_abab[oa, vb, va, ob], t1_aa)

#	  1.000000000000 <j,a||b,i>_bbbb*t1_bb(b,j)
singles_res +=  1.000000000000 * einsum('jabi,bj->ai', g_bbbb[ob, vb, vb, ob], t1_bb)

#	 -0.500000000000 <j,k||b,i>_abab*t2_abab(b,a,j,k)
singles_res += -0.500000000000 * einsum('jkbi,bajk->ai', g_abab[oa, ob, va, ob], t2_abab)

#	 -0.500000000000 <k,j||b,i>_abab*t2_abab(b,a,k,j)
singles_res += -0.500000000000 * einsum('kjbi,bakj->ai', g_abab[oa, ob, va, ob], t2_abab)

#	 -0.500000000000 <j,k||b,i>_bbbb*t2_bbbb(b,a,j,k)
singles_res += -0.500000000000 * einsum('jkbi,bajk->ai', g_bbbb[ob, ob, vb, ob], t2_bbbb)

#	  0.500000000000 <j,a||c,b>_abab*t2_abab(c,b,j,i)
singles_res +=  0.500000000000 * einsum('jacb,cbji->ai', g_abab[oa, vb, va, vb], t2_abab)

#	  0.500000000000 <j,a||b,c>_abab*t2_abab(b,c,j,i)
singles_res +=  0.500000000000 * einsum('jabc,bcji->ai', g_abab[oa, vb, va, vb], t2_abab)

#	 -0.500000000000 <j,a||c,b>_bbbb*t2_bbbb(c,b,i,j)
singles_res += -0.500000000000 * einsum('jacb,cbij->ai', g_bbbb[ob, vb, vb, vb], t2_bbbb)

#	 -0.250000000000 <j,k||c,b>_aaaa*t3_aabaab(c,b,a,k,j,i)
singles_res += -0.250000000000 * einsum('jkcb,cbakji->ai', g_aaaa[oa, oa, va, va], t3_aabaab)

#	 -0.250000000000 <j,k||c,b>_abab*t3_abbabb(c,b,a,j,i,k)
singles_res += -0.250000000000 * einsum('jkcb,cbajik->ai', g_abab[oa, ob, va, vb], t3_abbabb)

#	  0.250000000000 <k,j||c,b>_abab*t3_abbabb(c,b,a,k,j,i)
singles_res +=  0.250000000000 * einsum('kjcb,cbakji->ai', g_abab[oa, ob, va, vb], t3_abbabb)

#	 -0.250000000000 <j,k||b,c>_abab*t3_abbabb(b,c,a,j,i,k)
singles_res += -0.250000000000 * einsum('jkbc,bcajik->ai', g_abab[oa, ob, va, vb], t3_abbabb)

#	  0.250000000000 <k,j||b,c>_abab*t3_abbabb(b,c,a,k,j,i)
singles_res +=  0.250000000000 * einsum('kjbc,bcakji->ai', g_abab[oa, ob, va, vb], t3_abbabb)

#	  0.250000000000 <j,k||c,b>_bbbb*t3_bbbbbb(c,b,a,i,j,k)
singles_res +=  0.250000000000 * einsum('jkcb,cbaijk->ai', g_bbbb[ob, ob, vb, vb], t3_bbbbbb)

#	 -1.000000000000 <k,j||b,c>_aaaa*t1_aa(b,j)*t2_abab(c,a,k,i)
singles_res += -1.000000000000 * einsum('kjbc,bj,caki->ai', g_aaaa[oa, oa, va, va], t1_aa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <j,k||b,c>_abab*t1_aa(b,j)*t2_bbbb(c,a,i,k)
singles_res += -1.000000000000 * einsum('jkbc,bj,caik->ai', g_abab[oa, ob, va, vb], t1_aa, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <k,j||c,b>_abab*t1_bb(b,j)*t2_abab(c,a,k,i)
singles_res +=  1.000000000000 * einsum('kjcb,bj,caki->ai', g_abab[oa, ob, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <k,j||b,c>_bbbb*t1_bb(b,j)*t2_bbbb(c,a,i,k)
singles_res +=  1.000000000000 * einsum('kjbc,bj,caik->ai', g_bbbb[ob, ob, vb, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 <j,k||c,b>_abab*t1_bb(b,i)*t2_abab(c,a,j,k)
singles_res += -0.500000000000 * einsum('jkcb,bi,cajk->ai', g_abab[oa, ob, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 <k,j||c,b>_abab*t1_bb(b,i)*t2_abab(c,a,k,j)
singles_res += -0.500000000000 * einsum('kjcb,bi,cakj->ai', g_abab[oa, ob, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  0.500000000000 <j,k||b,c>_bbbb*t1_bb(b,i)*t2_bbbb(c,a,j,k)
singles_res +=  0.500000000000 * einsum('jkbc,bi,cajk->ai', g_bbbb[ob, ob, vb, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.500000000000 <k,j||c,b>_abab*t1_bb(a,j)*t2_abab(c,b,k,i)
singles_res += -0.500000000000 * einsum('kjcb,aj,cbki->ai', g_abab[oa, ob, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -0.500000000000 <k,j||b,c>_abab*t1_bb(a,j)*t2_abab(b,c,k,i)
singles_res += -0.500000000000 * einsum('kjbc,aj,bcki->ai', g_abab[oa, ob, va, vb], t1_bb, t2_abab, optimize=['einsum_path', (0, 2), (0, 1)])

#	  0.500000000000 <k,j||c,b>_bbbb*t1_bb(a,j)*t2_bbbb(c,b,i,k)
singles_res +=  0.500000000000 * einsum('kjcb,aj,cbik->ai', g_bbbb[ob, ob, vb, vb], t1_bb, t2_bbbb, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 <j,k||b,i>_abab*t1_bb(a,k)*t1_aa(b,j)
singles_res += -1.000000000000 * einsum('jkbi,ak,bj->ai', g_abab[oa, ob, va, ob], t1_bb, t1_aa, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 <k,j||b,i>_bbbb*t1_bb(a,k)*t1_bb(b,j)
singles_res +=  1.000000000000 * einsum('kjbi,ak,bj->ai', g_bbbb[ob, ob, vb, ob], t1_bb, t1_bb, optimize=['einsum_path', (0, 2), (0, 1)])

#	  1.000000000000 <j,a||b,c>_abab*t1_aa(b,j)*t1_bb(c,i)
singles_res +=  1.000000000000 * einsum('jabc,bj,ci->ai', g_abab[oa, vb, va, vb], t1_aa, t1_bb, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 <j,a||b,c>_bbbb*t1_bb(b,j)*t1_bb(c,i)
singles_res +=  1.000000000000 * einsum('jabc,bj,ci->ai', g_bbbb[ob, vb, vb, vb], t1_bb, t1_bb, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -1.000000000000 <j,k||b,c>_abab*t1_bb(a,k)*t1_aa(b,j)*t1_bb(c,i)
singles_res += -1.000000000000 * einsum('jkbc,ak,bj,ci->ai', g_abab[oa, ob, va, vb], t1_bb, t1_aa, t1_bb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])

#	  1.000000000000 <k,j||b,c>_bbbb*t1_bb(a,k)*t1_bb(b,j)*t1_bb(c,i)
singles_res +=  1.000000000000 * einsum('kjbc,ak,bj,ci->ai', g_bbbb[ob, ob, vb, vb], t1_bb, t1_bb, t1_bb, optimize=['einsum_path', (0, 2), (1, 2), (0, 1)])

return singles_res

