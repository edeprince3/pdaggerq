def ccsdt_t2_aaaa_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* b a e(-T) H e(T) | 0> :

#	 -1.000000000000 P(i,j)f_aa(k,j)*t2_aaaa(a,b,i,k)
contracted_intermediate = -1.000000000000 * einsum('kj,abik->abij', f_aa[oa, oa], t2_aaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  1.000000000000 P(a,b)f_aa(a,c)*t2_aaaa(c,b,i,j)
contracted_intermediate =  1.000000000000 * einsum('ac,cbij->abij', f_aa[va, va], t2_aaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 f_aa(k,c)*t3_aaaaaa(c,a,b,i,j,k)
doubles_res +=  1.000000000000 * einsum('kc,cabijk->abij', f_aa[oa, va], t3_aaaaaa)

#	 -1.000000000000 f_bb(k,c)*t3_aabaab(b,a,c,i,j,k)
doubles_res += -1.000000000000 * einsum('kc,bacijk->abij', f_bb[ob, vb], t3_aabaab)

#	 -1.000000000000 P(i,j)f_aa(k,c)*t1_aa(c,j)*t2_aaaa(a,b,i,k)
contracted_intermediate = -1.000000000000 * einsum('kc,cj,abik->abij', f_aa[oa, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 2), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -1.000000000000 P(a,b)f_aa(k,c)*t1_aa(a,k)*t2_aaaa(c,b,i,j)
contracted_intermediate = -1.000000000000 * einsum('kc,ak,cbij->abij', f_aa[oa, va], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 <a,b||i,j>_aaaa
doubles_res +=  1.000000000000 * einsum('abij->abij', g_aaaa[va, va, oa, oa])

#	  1.000000000000 P(a,b)<k,a||i,j>_aaaa*t1_aa(b,k)
contracted_intermediate =  1.000000000000 * einsum('kaij,bk->abij', g_aaaa[oa, va, oa, oa], t1_aa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(i,j)<a,b||c,j>_aaaa*t1_aa(c,i)
contracted_intermediate =  1.000000000000 * einsum('abcj,ci->abij', g_aaaa[va, va, va, oa], t1_aa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 <k,l||i,j>_aaaa*t2_aaaa(a,b,k,l)
doubles_res +=  0.500000000000 * einsum('klij,abkl->abij', g_aaaa[oa, oa, oa, oa], t2_aaaa)

#	  1.000000000000 P(i,j)*P(a,b)<k,a||c,j>_aaaa*t2_aaaa(c,b,i,k)
contracted_intermediate =  1.000000000000 * einsum('kacj,cbik->abij', g_aaaa[oa, va, va, oa], t2_aaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	 -1.000000000000 P(i,j)*P(a,b)<a,k||j,c>_abab*t2_abab(b,c,i,k)
contracted_intermediate = -1.000000000000 * einsum('akjc,bcik->abij', g_abab[va, ob, oa, vb], t2_abab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate)  + -1.00000 * einsum('abij->baij', contracted_intermediate)  +  1.00000 * einsum('abij->baji', contracted_intermediate) 

#	  0.500000000000 <a,b||d,c>_aaaa*t2_aaaa(d,c,i,j)
doubles_res +=  0.500000000000 * einsum('abdc,dcij->abij', g_aaaa[va, va, va, va], t2_aaaa)

#	  0.500000000000 P(i,j)<k,l||c,j>_aaaa*t3_aaaaaa(c,a,b,i,k,l)
contracted_intermediate =  0.500000000000 * einsum('klcj,cabikl->abij', g_aaaa[oa, oa, va, oa], t3_aaaaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(i,j)<k,l||j,c>_abab*t3_aabaab(b,a,c,i,k,l)
contracted_intermediate =  0.500000000000 * einsum('kljc,bacikl->abij', g_abab[oa, ob, oa, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(i,j)<l,k||j,c>_abab*t3_aabaab(b,a,c,i,l,k)
contracted_intermediate =  0.500000000000 * einsum('lkjc,bacilk->abij', g_abab[oa, ob, oa, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(a,b)<k,a||d,c>_aaaa*t3_aaaaaa(d,c,b,i,j,k)
contracted_intermediate =  0.500000000000 * einsum('kadc,dcbijk->abij', g_aaaa[oa, va, va, va], t3_aaaaaa)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  0.500000000000 P(a,b)<a,k||d,c>_abab*t3_aabaab(d,b,c,i,j,k)
contracted_intermediate =  0.500000000000 * einsum('akdc,dbcijk->abij', g_abab[va, ob, va, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	 -0.500000000000 P(a,b)<a,k||c,d>_abab*t3_aabaab(b,c,d,i,j,k)
contracted_intermediate = -0.500000000000 * einsum('akcd,bcdijk->abij', g_abab[va, ob, va, vb], t3_aabaab)
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->baij', contracted_intermediate) 

#	  1.000000000000 P(i,j)<l,k||c,j>_aaaa*t1_aa(c,k)*t2_aaaa(a,b,i,l)
contracted_intermediate =  1.000000000000 * einsum('lkcj,ck,abil->abij', g_aaaa[oa, oa, va, oa], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<l,k||j,c>_abab*t1_bb(c,k)*t2_aaaa(a,b,i,l)
contracted_intermediate = -1.000000000000 * einsum('lkjc,ck,abil->abij', g_abab[oa, ob, oa, vb], t1_bb, t2_aaaa, optimize=['einsum_path', (0, 1), (0, 1)])
doubles_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abij->abji', contracted_intermediate) 

#	  0.500000000000 P(i,j)<k,l||c,j>_aaaa*t1_aa(c,i)*t2_aaaa(a,b,k,l)
contracted_intermediate =  0.500000000000 * einsum('klcj,ci,abkl->abij', g_aaaa[oa, oa, va, oa], t1_aa, t2_aaaa, optimize=['einsum_path', (0, 2), (0, 1)])
