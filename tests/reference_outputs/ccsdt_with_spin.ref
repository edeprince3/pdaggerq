def ccsdt_t3_aabaab_residual(t1_aa, t1_bb, t2_aaaa, t2_bbbb, t2_abab, t3_aaaaaa, t3_aabaab, t3_abbabb, t3_bbbbbb, f_aa, f_bb, g_aaaa, g_bbbb, g_abab, oa, ob, va, vb):

#    < 0 | i* j* k* c b a e(-T) H e(T) | 0> :

#	  1.000000000000 P(i,j)f_aa(l,i)*t3_aabaab(a,b,c,j,l,k)
contracted_intermediate =  1.000000000000 * einsum('li,abcjlk->abcijk', f_aa[oa, oa], t3_aabaab)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,k)*t3_aabaab(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('lk,abcijl->abcijk', f_bb[ob, ob], t3_aabaab)

#	 -1.000000000000 f_aa(b,d)*t3_aabaab(d,a,c,i,j,k)
triples_res += -1.000000000000 * einsum('bd,dacijk->abcijk', f_aa[va, va], t3_aabaab)

#	 -1.000000000000 f_bb(c,d)*t3_aabaab(b,a,d,i,j,k)
triples_res += -1.000000000000 * einsum('cd,badijk->abcijk', f_bb[vb, vb], t3_aabaab)

#	  1.000000000000 f_aa(a,d)*t3_aabaab(d,b,c,i,j,k)
triples_res +=  1.000000000000 * einsum('ad,dbcijk->abcijk', f_aa[va, va], t3_aabaab)

#	  1.000000000000 f_aa(l,d)*t1_aa(b,l)*t3_aabaab(d,a,c,i,j,k)
triples_res +=  1.000000000000 * einsum('ld,bl,dacijk->abcijk', f_aa[oa, va], t1_aa, t3_aabaab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 f_bb(l,d)*t1_bb(c,l)*t3_aabaab(b,a,d,i,j,k)
triples_res +=  1.000000000000 * einsum('ld,cl,badijk->abcijk', f_bb[ob, vb], t1_bb, t3_aabaab, optimize=['einsum_path', (0, 2), (0, 1)])

#	 -1.000000000000 f_aa(l,d)*t1_aa(a,l)*t3_aabaab(d,b,c,i,j,k)
triples_res += -1.000000000000 * einsum('ld,al,dbcijk->abcijk', f_aa[oa, va], t1_aa, t3_aabaab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 P(i,j)f_aa(l,d)*t1_aa(d,i)*t3_aabaab(a,b,c,j,l,k)
contracted_intermediate =  1.000000000000 * einsum('ld,di,abcjlk->abcijk', f_aa[oa, va], t1_aa, t3_aabaab, optimize=['einsum_path', (0, 2), (0, 1)])
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 f_bb(l,d)*t1_bb(d,k)*t3_aabaab(a,b,c,i,j,l)
triples_res += -1.000000000000 * einsum('ld,dk,abcijl->abcijk', f_bb[ob, vb], t1_bb, t3_aabaab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 f_aa(l,d)*t2_aaaa(a,b,j,l)*t2_abab(d,c,i,k)
triples_res +=  1.000000000000 * einsum('ld,abjl,dcik->abcijk', f_aa[oa, va], t2_aaaa, t2_abab, optimize=['einsum_path', (0, 1), (0, 1)])

#	  1.000000000000 f_bb(l,d)*t2_abab(a,c,j,l)*t2_abab(b,d,i,k)
