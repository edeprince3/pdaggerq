contracted_intermediate = -1.000000000000 * einsum('blij,ackl->abcijk', g[v, o, o, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(b,c)<b,l||j,k>*t2(a,c,i,l)
contracted_intermediate = -1.000000000000 * einsum('bljk,acil->abcijk', g[v, o, o, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	  1.000000000000 P(j,k)<a,l||i,j>*t2(b,c,k,l)
contracted_intermediate =  1.000000000000 * einsum('alij,bckl->abcijk', g[v, o, o, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	  1.000000000000 <a,l||j,k>*t2(b,c,i,l)
triples_res +=  1.000000000000 * einsum('aljk,bcil->abcijk', g[v, o, o, o], t2)

#	 -1.000000000000 P(i,j)*P(a,b)<a,c||i,d>*t2(d,b,j,k)
contracted_intermediate = -1.000000000000 * einsum('acid,dbjk->abcijk', g[v, v, o, v], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<a,c||k,d>*t2(d,b,i,j)
contracted_intermediate = -1.000000000000 * einsum('ackd,dbij->abcijk', g[v, v, o, v], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	  1.000000000000 P(i,j)<a,b||i,d>*t2(d,c,j,k)
contracted_intermediate =  1.000000000000 * einsum('abid,dcjk->abcijk', g[v, v, o, v], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	  1.000000000000 <a,b||k,d>*t2(d,c,i,j)
triples_res +=  1.000000000000 * einsum('abkd,dcij->abcijk', g[v, v, o, v], t2)


    E(t)

['+0.250', '<j,k||c,b>', 't3(c,b,a,i,j,k)', 'l1(i,a)']
['-0.250', '<j,k||l,c>', 't3(c,a,b,i,j,k)', 'l2(i,l,a,b)']
['-0.250', '<d,k||b,c>', 't3(b,c,a,j,i,k)', 'l2(j,i,d,a)']
#	  0.250000000000 <j,k||c,b>*t3(c,b,a,i,j,k)*l1(i,a)
energy +=  0.250000000000 * einsum('jkcb,cbaijk,ia', g[o, o, v, v], t3, l1, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.250000000000 <j,k||l,c>*t3(c,a,b,i,j,k)*l2(i,l,a,b)
energy += -0.250000000000 * einsum('jklc,cabijk,ilab', g[o, o, o, v], t3, l2, optimize=['einsum_path', (0, 1), (0, 1)])

#	 -0.250000000000 <d,k||b,c>*t3(b,c,a,j,i,k)*l2(j,i,d,a)
energy += -0.250000000000 * einsum('dkbc,bcajik,jida', g[v, o, v, v], t3, l2, optimize=['einsum_path', (0, 1), (0, 1)])

