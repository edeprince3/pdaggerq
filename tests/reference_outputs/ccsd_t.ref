contracted_intermediate = -1.000000000000 * einsum('lajk,bcil->abcijk', g[o, v, o, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate)  + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->bacjik', contracted_intermediate) 

#	 -1.000000000000 P(a,b)<l,a||i,j>*t2(b,c,k,l)
contracted_intermediate = -1.000000000000 * einsum('laij,bckl->abcijk', g[o, v, o, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->bacijk', contracted_intermediate) 

#	 -1.000000000000 P(i,j)<l,c||j,k>*t2(a,b,i,l)
contracted_intermediate = -1.000000000000 * einsum('lcjk,abil->abcijk', g[o, v, o, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcjik', contracted_intermediate) 

#	 -1.000000000000 <l,c||i,j>*t2(a,b,k,l)
triples_res += -1.000000000000 * einsum('lcij,abkl->abcijk', g[o, v, o, o], t2)

#	 -1.000000000000 P(j,k)*P(b,c)<a,b||d,k>*t2(d,c,i,j)
contracted_intermediate = -1.000000000000 * einsum('abdk,dcij->abcijk', g[v, v, v, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate)  + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate)  +  1.00000 * einsum('abcijk->acbikj', contracted_intermediate) 

#	 -1.000000000000 P(b,c)<a,b||d,i>*t2(d,c,j,k)
contracted_intermediate = -1.000000000000 * einsum('abdi,dcjk->abcijk', g[v, v, v, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->acbijk', contracted_intermediate) 

#	 -1.000000000000 P(j,k)<b,c||d,k>*t2(d,a,i,j)
contracted_intermediate = -1.000000000000 * einsum('bcdk,daij->abcijk', g[v, v, v, o], t2)
triples_res +=  1.00000 * contracted_intermediate + -1.00000 * einsum('abcijk->abcikj', contracted_intermediate) 

#	 -1.000000000000 <b,c||d,i>*t2(d,a,j,k)
triples_res += -1.000000000000 * einsum('bcdi,dajk->abcijk', g[v, v, v, o], t2)


    E(t)

['+0.250', '<j,k||c,b>', 't3(c,b,a,i,j,k)', 'l1(i,a)']
['+0.250', '<j,k||c,l>', 't3(c,a,b,i,j,k)', 'l2(i,l,a,b)']
['+0.250', '<k,d||b,c>', 't3(b,c,a,j,i,k)', 'l2(j,i,d,a)']
#	  0.250000000000 <j,k||c,b>*t3(c,b,a,i,j,k)*l1(i,a)
energy +=  0.250000000000 * einsum('jkcb,cbaijk,ia', g[o, o, v, v], t3, l1, optimize=['einsum_path', (0, 1), (0, 1)])

#	  0.250000000000 <j,k||c,l>*t3(c,a,b,i,j,k)*l2(i,l,a,b)
energy +=  0.250000000000 * einsum('jkcl,cabijk,ilab', g[o, o, v, o], t3, l2, optimize=['einsum_path', (0, 1), (0, 1)])

#	  0.250000000000 <k,d||b,c>*t3(b,c,a,j,i,k)*l2(j,i,d,a)
energy +=  0.250000000000 * einsum('kdbc,bcajik,jida', g[o, v, v, v], t3, l2, optimize=['einsum_path', (0, 1), (0, 1)])

