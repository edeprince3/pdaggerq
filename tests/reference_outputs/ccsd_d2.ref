tpdm[o, v, v, o] += -0.500000000000 * einsum('ij,bclk,lkac->iabj', kd[o, o], t2, l2, optimize=['einsum_path', (1, 2), (0, 1)])

#	  1.000000000000 t2(b,c,k,i)*l2(k,j,a,c)
tpdm[o, v, v, o] +=  1.000000000000 * einsum('bcki,kjac->iabj', t2, l2)

