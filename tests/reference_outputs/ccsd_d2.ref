tpdm[o, o, v, v] +=  1.00000 * contracted_intermediate + -1.00000 * einsum('ijab->jiab', contracted_intermediate)  + -1.00000 * einsum('ijab->ijba', contracted_intermediate)  +  1.00000 * einsum('ijab->jiba', contracted_intermediate) 

#	 -0.500000000000 t1(c,i)*t1(d,j)*t2(a,b,l,k)*l2(l,k,d,c)
tpdm[o, o, v, v] += -0.500000000000 * einsum('ci,dj,ablk,lkdc->ijab', t1, t1, t2, l2, optimize=['einsum_path', (0, 3), (0, 2), (0, 1)])

#	  1.000000000000 P(i,j)*P(a,b)t1(a,j)*t1(b,k)*t1(c,i)*l1(k,c)
contracted_intermediate =  1.000000000000 * einsum('aj,bk,ci,kc->ijab', t1, t1, t1, l1, optimize=['einsum_path', (1, 3), (1, 2), (0, 1)])
tpdm[o, o, v, v] +=  1.00000 * contracted_intermediate + -1.00000 * einsum('ijab->jiab', contracted_intermediate)  + -1.00000 * einsum('ijab->ijba', contracted_intermediate)  +  1.00000 * einsum('ijab->jiba', contracted_intermediate) 

#	  1.000000000000 t1(a,k)*t1(b,l)*t1(c,i)*t1(d,j)*l2(l,k,d,c)
tpdm[o, o, v, v] +=  1.000000000000 * einsum('ak,bl,ci,dj,lkdc->ijab', t1, t1, t1, t1, l2, optimize=['einsum_path', (0, 4), (0, 3), (0, 2), (0, 1)])


 #    D2(a,b,i,j): 

#	  1.000000000000 l2(i,j,a,b)
tpdm[v, v, o, o] +=  1.000000000000 * einsum('ijab->abij', l2)


 #    D2(i,a,j,b): 

#	  1.000000000000 d(i,j)*t1(b,k)*l1(k,a)
tpdm[o, v, o, v] +=  1.000000000000 * einsum('ij,bk,ka->iajb', kd[o, o], t1, l1, optimize=['einsum_path', (1, 2), (0, 1)])

#	 -1.000000000000 t1(b,i)*l1(j,a)
tpdm[o, v, o, v] += -1.000000000000 * einsum('bi,ja->iajb', t1, l1)

#	  0.500000000000 d(i,j)*t2(b,c,l,k)*l2(l,k,a,c)
tpdm[o, v, o, v] +=  0.500000000000 * einsum('ij,bclk,lkac->iajb', kd[o, o], t2, l2, optimize=['einsum_path', (1, 2), (0, 1)])

#	 -1.000000000000 t2(b,c,k,i)*l2(k,j,a,c)
